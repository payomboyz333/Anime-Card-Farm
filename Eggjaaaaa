----------------------------------------------------------------
-- UI refresh
--
-- One job, five seconds, and only while the window is open: a hidden panel that
-- keeps rebuilding strings is pure waste on a box running many clients.
----------------------------------------------------------------
job("ui", 5, function()
    local data = saveData()
    local mins = math.max((os.clock() - Runtime.stats.startedAt) / 60, 0.01)
    local money = tonumber(data.Money) or 0
    local gain  = money - (Runtime.stats.startMoney or money)

    pcall(function()
        StatusBox:SetDesc(("โหมด: %s%s | ไข่ %d ใบ (%.1f/นาที) | ฟัก %d\nเงิน %s (+%s ตั้งแต่เริ่ม) | กระเป๋าไข่ %d/%d\n%s")
            :format(
                Cfg.MoveMode,
                Runtime.instantReady and "" or " (วาปตรงยังไม่พร้อม ใช้ Warp แทน)",
                Runtime.stats.eggs, Runtime.stats.eggs / mins, Runtime.stats.hatched,
                shortNum(money), shortNum(gain),
                bagCount(), EGG_BAG_CAP,
                Runtime.lastError and ("ล่าสุด: " .. tostring(Runtime.lastError)) or "ทำงานปกติ"))
    end)

    -- read what the seller already computed; never rebuild the plan on this thread
    pcall(function()
        local pv = Runtime.sellPreview
        if not pv then
            SellPreview:SetDesc("กำลังอ่านกระเป๋า...")
        elseif pv.count == 0 then
            SellPreview:SetDesc("ตอนนี้ไม่มีสัตว์ตัวไหนเข้าตัวกรอง — เปิดสวิตช์ก็ไม่มีอะไรหาย")
        else
            SellPreview:SetDesc(("เข้าตัวกรอง %d ตัว รวมราว %s • คิวเหลือ %d\nจังหวะขายตอนนี้ %.1f ครั้ง/วิ (เฟรมแย่สุด %d ms)\n%s")
                :format(pv.count, shortNum(pv.total), #sellQueue,
                    1 / math.max(Runtime.sellPace or (Cfg.SellPace or 0.05), 0.001),
                    Runtime.sellWorstMs or 0,
                    pv.head or ""))
        end
    end)

    pcall(function()
        local lvl = tonumber(data.BaseUpgradeLevel) or 0
        local tm  = tonumber(data.TreadmillUpgradeLevel) or 0
        local nextBase = BasesDir and BasesDir.BASES and BasesDir.BASES[lvl + 1]
        local nextTm
        if TreadDir and TreadDir.GetByUpgradeLevel then
            local ok, t = pcall(TreadDir.GetByUpgradeLevel, tm + 1)
            if ok then nextTm = t end
        end
        ProgBox:SetDesc(("ฐาน เลเวล %d → ขั้นถัดไป %s\nลู่วิ่ง เลเวล %d → ขั้นถัดไป %s\nสัตว์ในกระเป๋า %d ตัว")
            :format(
                lvl, nextBase and shortNum(nextBase.Cost) or "สุดแล้ว",
                tm, (type(nextTm) == "table") and ((nextTm.DisplayName or nextTm._id) .. " " .. shortNum(nextTm.Price)) or "สุดแล้ว",
                Runtime.petCount or 0))
    end)

    pcall(function()
        LogBox:SetDesc(#Runtime.log == 0 and "-" or table.concat(Runtime.log, "\n", 1, math.min(8, #Runtime.log)))
    end)

    if Runtime.refreshCfgBox then Runtime.refreshCfgBox() end
end)

