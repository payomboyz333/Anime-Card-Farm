-- pets: equip / sell
----------------------------------------------------------------
local function equipBest()
    invoke(NET.Backpack.EQUIP_BEST)

    local limit = tonumber(invoke(NET.ActiveAssets.REQUEST_EQUIP_LIMIT)) or 0
    if limit <= 0 then return 0 end

    -- runs every few seconds with the whole inventory behind it, so it breathes
    -- instead of unpacking two hundred pets inside one frame
    local list = petItems(false, 40)
    if #list == 0 then return 0 end
    table.sort(list, function(a, b) return a.rate > b.rate end)

    local want, equipped = {}, {}
    for i = 1, math.min(limit, #list) do want[list[i].uid] = true end
    for _, p in ipairs(list) do if p.equipped then equipped[p.uid] = true end end

    local changed = 0
    for uid in pairs(equipped) do
        if not want[uid] then
            if AssetCmds then pcall(AssetCmds.RequestUnequipAsset, uid) else invoke(NET.ActiveAssets.REQUEST_UNEQUIP, uid) end
            changed += 1
            task.wait(0.06)
        end
    end
    for uid in pairs(want) do
        if not equipped[uid] then
            if AssetCmds then pcall(AssetCmds.RequestEquipAsset, uid) else invoke(NET.ActiveAssets.REQUEST_EQUIP, uid) end
            changed += 1
            task.wait(0.06)
        end
    end
    return changed
end

-- ActiveAssets.REQUEST_SELL takes ONE uid, is validated server side, and answers
-- from anywhere. AssetInventory.SELL_ASSET only works on a held tool and
-- SELL_ALL_ASSETS is the stand's bulk dump — neither respects a filter.
local function sellPetPlan(yieldEvery)
    local list = petItems(false, yieldEvery)
    table.sort(list, function(a, b) return a.rate > b.rate end)

    local keep = {}
    for i = 1, math.min(Cfg.SellKeepTop or 0, #list) do keep[list[i].uid] = true end

    local plan = {}
    for _, p in ipairs(list) do
        -- hard rails: these are never sold, whatever the filters say
        if not (p.equipped or p.favorite or p.inFuse or keep[p.uid]) then
            local limit    = tonumber(Cfg.SellPetBelow) or 0
            local byPrice  = limit > 0 and p.price < limit
            local byRarity = Cfg.SellPetRarities[p.rarity] == true

            local take
            if Cfg.SellPetMode == "ระดับที่เลือก" then take = byRarity
            elseif Cfg.SellPetMode == "เข้าทั้งสองเงื่อนไข" then take = byRarity and byPrice
            else take = byPrice end

            if take then plan[#plan + 1] = p end
        end
    end
    table.sort(plan, function(a, b) return a.price < b.price end)
    return plan
end

----------------------------------------------------------------
-- realtime seller
--
-- The stutter came from the old shape: rebuild a 200-entry plan, then fire eight
-- RemoteFunction invokes on one frame and block until they all answer. Eight
-- yields landing together is a visible hitch, and it repeated every ten seconds.
--
-- This runs continuously instead. One launch per tick at most, a few in flight at
-- a time, and the candidate list is only rebuilt when the inventory actually
-- changed. No frame ever carries more than a single request, so there is nothing
-- left to stutter — and a pet that becomes sellable is gone within a tick or two
-- instead of waiting for the next sweep.
----------------------------------------------------------------
local sellDirty   = true
local sellQueue   = {}
local sellFlight  = 0
local sellLastScan = 0

local function markSellDirty() sellDirty = true end

local function refillSellQueue()
    -- 40 at a time: the rebuild is spread over a handful of frames instead of
    -- landing on one, which is the difference between a smooth run and a freeze
    local plan = sellPetPlan(40)
    table.clear(sellQueue)
    -- cheapest first, and the queue is popped from the end
    for i = #plan, 1, -1 do sellQueue[#sellQueue + 1] = plan[i] end

    local total = 0
    for _, p in ipairs(plan) do total += p.price end
    local head = {}
    for i = 1, math.min(5, #plan) do
        head[#head + 1] = ("• %s (%s) — %s"):format(plan[i].cat, RARITY_TH[plan[i].rarity] or plan[i].rarity, shortNum(plan[i].price))
    end
    if #plan > 5 then head[#head + 1] = ("...และอีก %d ตัว"):format(#plan - 5) end
    -- the panel reads this instead of rebuilding the plan itself every 5 seconds
    Runtime.sellPreview = { count = #plan, total = total, head = table.concat(head, "\n") }

    sellDirty = false
    sellLastScan = os.clock()
end

-- kept for the API and the "sell now" path: same pacing, just runs to completion
local function sellPets(maxCount)
    local plan = sellPetPlan()
    local cap  = math.min(maxCount or math.huge, math.max(1, Cfg.SellMaxPerRun or 60))
    local sold, earned = 0, 0

    for _, p in ipairs(plan) do
        if sold >= cap then break end
        if invoke(NET.ActiveAssets.REQUEST_SELL, p.uid) then
            sold += 1
            earned += p.price
        end
        task.wait(0.03)
    end

    Runtime.stats.soldPets += sold
    saveCache, petCache = nil, nil
    markSellDirty()
    if sold > 0 then logLine("sell", ("ขายสัตว์ %d ตัว ได้ %s"):format(sold, shortNum(earned))) end
    return sold, earned
end

