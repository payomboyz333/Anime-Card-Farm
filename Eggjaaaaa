local NET = Network.NET_MAP
local NetworkFolder = ReplicatedStorage:FindFirstChild("Network")

local function remoteKind(endpoint)
    local inst = NetworkFolder and NetworkFolder:FindFirstChild(tostring(endpoint))
    if not inst then return nil end
    return inst:IsA("RemoteFunction") and "function" or "event"
end

local function invoke(endpoint, ...)
    local args = table.pack(...)
    if remoteKind(endpoint) == "event" then
        local ok = pcall(function() Network.Fire(endpoint, table.unpack(args, 1, args.n)) end)
        return ok
    end
    local ok, a, b = pcall(function() return Network.Invoke(endpoint, table.unpack(args, 1, args.n)) end)
    if not ok then return false, tostring(a) end
    return a, b
end

local function fire(endpoint, ...)
    local args = table.pack(...)
    pcall(function() Network.Fire(endpoint, table.unpack(args, 1, args.n)) end)
end

