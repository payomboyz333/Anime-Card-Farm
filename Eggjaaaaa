-- Auto Treadmill (ลู่วิ่ง) Loop
task.spawn(function()
    while true do
        task.wait(Config.TreadmillSpeed)
        if Config.AutoTreadmill then
            pcall(function()
                local root = getRootPart()
                local myPlot = getMyPlot()
                if root then
                    if myPlot then
                        local treadmill = myPlot:FindFirstChild("TreadmillBottom", true) or myPlot:FindFirstChild("Treadmill", true)
                        if treadmill and treadmill:IsA("BasePart") then
                            firetouchinterest(root, treadmill, 0)
                            firetouchinterest(root, treadmill, 1)
                        end
                    end
                    -- Map fallback scan
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v.Name:lower():find("treadmill") or v.Name:lower():find("runpad") or v.Name:lower():find("speedpad") then
                            if v:IsA("BasePart") then
                                firetouchinterest(root, v, 0)
                                firetouchinterest(root, v, 1)
                            elseif v:IsA("ProximityPrompt") then
                                fireproximityprompt(v)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Auto Equip Best, Trails & Plot Upgrades Loop
task.spawn(function()
    while true do
        task.wait(1.5)
