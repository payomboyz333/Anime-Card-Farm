-- WindUI hands a multi dropdown back as an array in some builds and as a
-- {name = true} dictionary in others, and a single dropdown as a bare string.
-- Reading only one of those shapes is how a filter silently ends up empty and
-- the whole loop sits there doing nothing.
-- same story as the dropdowns: a toggle can hand back the element instead of a
-- boolean, and a truthy table silently arms whatever it controls
local function isOn(v) return v == true end

local function toSet(value)
    local set = {}
    if type(value) == "table" then
        for k, v in pairs(value) do
            if type(k) == "number" then
                if type(v) == "string" then set[v] = true end
            elseif v then
                set[k] = true
            end
        end
    elseif type(value) == "string" then
        set[value] = true
    end
    return set
end

