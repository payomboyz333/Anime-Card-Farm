local function baseUpgradeStep()
    if not BasesDir or not BasesDir.BASES then return end
    local data = saveData()
    local lvl  = tonumber(data.BaseUpgradeLevel) or 0
    local maxLvl = 99
    if BasesDir.GetMaxBaseLevel then
        local ok, m = pcall(BasesDir.GetMaxBaseLevel)
        if ok and tonumber(m) then maxLvl = tonumber(m) end
    end
    if lvl >= maxLvl then return end

    local nextCfg = BasesDir.BASES[lvl + 1]
    local cost = nextCfg and tonumber(nextCfg.Cost)
    if not cost then return end
    if moneyNow() < cost then return end

    fire(NET.Plots.REQUEST_BASE_UPGRADE)
    logLine("base", ("อัปฐานเป็นเลเวล %d (%s)"):format(lvl + 1, shortNum(cost)))
    saveCache, petCache = nil, nil
end

local function treadmillUpgradeStep()
    if not TreadDir or not TreadDir.GetByUpgradeLevel then return end
    local data = saveData()
    local lvl  = tonumber(data.TreadmillUpgradeLevel) or 0

    local ok, nextTm = pcall(TreadDir.GetByUpgradeLevel, lvl + 1)
    if not ok or type(nextTm) ~= "table" then return end
    local price = tonumber(nextTm.Price) or math.huge
    if moneyNow() < price then return end

    invoke(NET.Treadmills.REQUEST_UPGRADE, nextTm._id)
    logLine("treadmill", ("อัปลู่วิ่งเป็น %s (%s)"):format(nextTm.DisplayName or nextTm._id, shortNum(price)))
    saveCache, petCache = nil, nil
end

local function trailsStep()
    if not TrailsDir or not TrailsDir.Directory then return end
    local data  = saveData()
    local owned = data.TrailInventory or {}
    local money = tonumber(data.Money) or 0

    local list = {}
    for id, cfg in pairs(TrailsDir.Directory) do
        if type(cfg) == "table" then
            list[#list + 1] = { id = cfg._id or id, price = tonumber(cfg.Price) or math.huge, speed = tonumber(cfg.SpeedMultiplier) or 0 }
        end
    end
    table.sort(list, function(a, b) return a.speed > b.speed end)

    for _, item in ipairs(list) do
        if not owned[item.id] and item.price > 0 and item.price <= money then
            invoke(NET.Trails.REQUEST_PURCHASE, item.id)
            logLine("trail", ("ซื้อเทรล %s"):format(item.id))
            saveCache, petCache = nil, nil
            task.wait(0.3)
            owned = saveData(true).TrailInventory or owned
            break
        end
    end

    for _, item in ipairs(list) do
        if owned[item.id] then
            if data.EquippedTrail ~= item.id then invoke(NET.Trails.REQUEST_SELECT, item.id) end
            return
        end
    end
end

-- Two things made this look permanently broken:
--   * the machine keeps whatever was loaded into it between attempts, so every
--     later insert answers "Fuse machine is full!" and the run gave up
--   * a fuse pays out an egg, so a full egg bag answers "Your egg inventory is
--     full!" and nothing happens either
-- So: clear the bag if needed, finish or empty whatever is already loaded, then
-- load a fresh trio.
local function fuseFinish(label)
    local ok, err = invoke(NET.FuseMachine.START_FUSE)
    if not ok then return false, err end
    task.wait(0.4)
    invoke(NET.FuseMachine.COMPLETE_REVEAL)
    invoke(NET.FuseMachine.ACKNOWLEDGE_INFO)
    logLine("fuse", ("ผสม %s"):format(label))
    saveCache, petCache = nil, nil
    markSellDirty()
    return true
end

local function fuseStep()
    if bagCount() >= EGG_BAG_CAP - 1 then relieveBag(true) end

    local pets = petItems()
    local loaded, byCat = {}, {}
    for _, p in ipairs(pets) do
        if p.inFuse then
            loaded[#loaded + 1] = p
        elseif not (p.equipped or p.favorite) then
            byCat[p.cat] = byCat[p.cat] or {}
            table.insert(byCat[p.cat], p.uid)
        end
    end

    -- something is already sitting in the machine: finish it, or clear it out
    if #loaded >= 3 then
        local ok, err = fuseFinish(loaded[1].cat)
        if ok then return true end
        Runtime.lastError = "ผสมไม่ได้: " .. tostring(err)
        return false
    elseif #loaded > 0 then
        for _, p in ipairs(loaded) do invoke(NET.FuseMachine.REMOVE_MOB, p.uid) end
        saveCache, petCache = nil, nil
    end

    for cat, uids in pairs(byCat) do
        if #uids >= 3 then
            local inserted = 0
            for i = 1, 3 do
                if invoke(NET.FuseMachine.INSERT_MOB, uids[i]) then inserted += 1 end
            end
            if inserted == 3 then
                local ok, err = fuseFinish(cat .. " x3")
                if ok then return true end
                for i = 1, 3 do invoke(NET.FuseMachine.REMOVE_MOB, uids[i]) end
                Runtime.lastError = "ผสมไม่ได้: " .. tostring(err)
                return false
            end
            -- partial load is worse than none: take it back out and stop
            for i = 1, 3 do invoke(NET.FuseMachine.REMOVE_MOB, uids[i]) end
            return false
        end
    end
    return false
end

local function claimStep()
    invoke(NET.OfflineAssets.REQUEST_REDEEM)
    invoke(NET.Index.REQUEST_CLAIM_ALL)
end

----------------------------------------------------------------
-- anti-lag
--
-- Not a cosmetic toggle: on a box running many clients the render work is what
-- kills the frame budget. Effects are destroyed rather than hidden, and the
-- sweep is throttled so it never becomes the lag itself.
----------------------------------------------------------------
local KILL_CLASSES = {
    ParticleEmitter = true, Trail = true, Smoke = true, Fire = true,
    Sparkles = true, Beam = true, Explosion = true, Highlight = true,
}

local function stripInstance(inst)
    local cls = inst.ClassName
    if KILL_CLASSES[cls] then
        inst:Destroy()
        return
    end
    if Cfg.LowFXOnly then return end
    if cls == "Texture" or cls == "Decal" then
        inst:Destroy()
    elseif inst:IsA("BasePart") then
        inst.Material = Enum.Material.SmoothPlastic
        inst.Reflectance = 0
        inst.CastShadow = false
        if inst:IsA("MeshPart") then inst.RenderFidelity = Enum.RenderFidelity.Performance end
    end
end

local function antiLagGlobals()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e6
        Lighting.Brightness = 1
        for _, fx in ipairs(Lighting:GetChildren()) do
            if fx:IsA("PostEffect") or fx:IsA("Atmosphere") then fx:Destroy() end
        end
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        end
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end)
end

-- the map is ~37k instances, so the first pass yields every few thousand instead
-- of hitching the client, and it runs once. after that only new instances matter.
local fullPassRunning = false

-- Counting instances is the wrong budget. Three thousand of these in one frame is
-- a visible hitch when they are MeshParts (four property writes each) and nothing
-- at all when they are Attachments, so the pass watches the clock instead: work
-- until this frame has had its few milliseconds, then hand the frame back. The map
-- takes a couple of seconds longer to sweep and never costs a dropped frame.
local FULL_PASS_MS = 0.004

local function antiLagFullPass()
    if fullPassRunning then return end
    fullPassRunning = true
    task.spawn(function()
        antiLagGlobals()
        local all = Workspace:GetDescendants()
        local slice = os.clock()
        for i = 1, #all do
            local inst = all[i]
            if inst.Parent then pcall(stripInstance, inst) end
            if os.clock() - slice > FULL_PASS_MS then
                task.wait()
                slice = os.clock()
            end
        end
        all = nil
        Runtime.lastError = nil
        logLine("lag", ("แก้แลค: กวาดครบทั้งแมพแล้ว"))
        fullPassRunning = false
    end)
end

-- anything the game streams in afterwards is caught here instead of by rescanning
-- the whole tree on a timer, which was the expensive way to find nothing
local fxQueue = {}

Runtime.conns.fx = Workspace.DescendantAdded:Connect(function(inst)
    if not Cfg.AntiLag then return end
    fxQueue[#fxQueue + 1] = inst
end)

local function hideOtherPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                    pcall(function() part.LocalTransparencyModifier = 1 end)
                elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
                    pcall(function() part:Destroy() end)
                end
            end
        end
    end
end

local function antiLagSweep()
    if not Cfg.AntiLag then
        if #fxQueue > 0 then table.clear(fxQueue) end
        return
    end

    antiLagGlobals()

    -- drain what streamed in, newest first, on a frame budget rather than a count:
    -- 1500 MeshParts in one frame is a hitch, 1500 attachments is nothing
    local slice    = os.clock()
    local deadline = slice + 0.75      -- a stream that outruns us waits for the next sweep
    while #fxQueue > 0 and os.clock() < deadline do
        local inst = table.remove(fxQueue)
        if inst and inst.Parent then pcall(stripInstance, inst) end
        if os.clock() - slice > 0.003 then
            RunService.Heartbeat:Wait()
            slice = os.clock()
        end
    end
    if #fxQueue > 4000 then table.clear(fxQueue) end

    if Cfg.HideOtherPlayers then pcall(hideOtherPlayers) end
end

----------------------------------------------------------------
-- housekeeping
----------------------------------------------------------------
local function gcSweep()
    local now = os.clock()
    for uid, until_ in pairs(Runtime.skip) do
        if now > until_ then Runtime.skip[uid] = nil end
    end
    for i = #Runtime.log, 41, -1 do Runtime.log[i] = nil end
    saveCache, petCache = nil, nil
    table.clear(fxQueue)
    -- drop anything the game left parented to nil in our own folders
    pcall(function() collectgarbage("count") end)
end

local serverHop   -- defined below; the gate in front of it is what matters

-- Hop the moment this server has nothing the player wants -- and only then.
--
-- The trap is that "no eggs" and "no data yet" look identical. A client that just
-- teleported in has an empty egg snapshot for the first few seconds, so a check
-- that trusts the first empty answer hops again immediately, and again on the next
-- server: an endless hop loop that never steals anything. Everything here exists to
-- tell those two states apart:
--
--   * the snapshot must be populated at all (records > 0) -- an empty table is "not
--     loaded", never "no eggs", and it stops the hop cold;
--   * the script must have been in this server long enough for the feed to arrive;
--   * the empty answer must survive HopChecks separate reads, each after its own
--     fresh RequestAreaEggSnapshot, spaced a second apart, and a single matching egg
--     in any of them cancels the whole thing;
--   * consecutive hops that steal nothing are counted ACROSS servers (in a file --
--     each teleport is a new Lua state), and after HopMaxTries the hopping stops by
--     itself and says why. A filter no server can satisfy is a filter problem, and
--     hopping forever is not an answer to it.
local HOP_FILE = CFG_DIR .. "/hopstate.json"

local function readHopState()
    local data = hasFS and readJson and readJson(HOP_FILE) or nil
    if type(data) ~= "table" then return { count = 0, at = 0 } end
    -- a run that has been quiet for five minutes is not the same chain of hops
    if (os.time() - (tonumber(data.at) or 0)) > 300 then return { count = 0, at = 0 } end
    return { count = tonumber(data.count) or 0, at = tonumber(data.at) or 0 }
end

local function writeHopState(count)
    if not hasFS then return end
    pcall(function()
        writefile(HOP_FILE, HttpService:JSONEncode({ count = count, at = os.time() }))
    end)
end

Runtime.hopChain = readHopState().count

-- true = there is something to take, false = there is not, nil = we cannot tell yet
local function zoneHasWanted()
    pcall(EggCmds.RequestAreaEggSnapshot)
    task.wait(0.25)

    local seen = 0
    for _ in pairs(areaEggRecords()) do seen += 1 end
    if seen == 0 then return nil end          -- no data is not the same as no eggs

    return matchingEggCount() > 0, seen
end

local function hopIfTrulyEmpty()
    if not Cfg.AutoHop then return false end
    if Runtime.carryUid then return false end
    if Runtime.hopStopped then return false end

    -- a client that just arrived has not received the egg feed yet
    if os.clock() - (Runtime.stats.startedAt or 0) < 12 then return false end
    if Runtime.lastHopAt and os.clock() - Runtime.lastHopAt < 20 then return false end

    local checks = math.clamp(tonumber(Cfg.HopChecks) or 3, 2, 6)
    local seenAny = 0
    for i = 1, checks do
        local has, seen = zoneHasWanted()
        if has == nil then
            -- snapshot still empty: the server has not told us anything yet
            return false
        end
        if has then return false end
        seenAny = math.max(seenAny, seen or 0)
        if i < checks then task.wait(1) end
    end

    -- every hop that steals nothing counts; a filter nothing can satisfy stops here
    local chain = (Runtime.hopChain or 0) + 1
    Runtime.hopChain = chain
    writeHopState(chain)

    local maxTries = math.clamp(tonumber(Cfg.HopMaxTries) or 6, 1, 30)
    if chain > maxTries then
        Runtime.hopStopped = true
        logLine("hop", ("ย้ายเซิร์ฟ %d ครั้งติดยังไม่เจอไข่ตรงตัวกรอง — หยุดย้าย ลองเพิ่มระดับหรือโซนในตัวกรอง"):format(chain - 1))
        Notify("ย้ายเซิร์ฟเวอร์",
            ("ย้ายมา %d ครั้งติดยังไม่เจอไข่ที่ตั้งไว้เลย — หยุดย้ายแล้ว ลองเพิ่มระดับไข่หรือโซนในตัวกรอง"):format(chain - 1), 8)
        return false
    end

    Runtime.lastHopAt = os.clock()
    logLine("hop", ("โซนนี้ไม่มีไข่ตรงตัวกรอง (เช็ค %d ครั้ง, เห็นไข่ในแมพ %d ใบ) — ย้ายเซิร์ฟ ครั้งที่ %d")
        :format(checks, seenAny, chain))
    return serverHop()
end

function serverHop()
    local ok, servers = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100"):format(game.PlaceId)))
    end)
    if ok and servers and servers.data then
        for _, s in ipairs(servers.data) do
            if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, s.id, LocalPlayer)
                return true
            end
        end
    end
    pcall(TeleportService.Teleport, TeleportService, game.PlaceId, LocalPlayer)
    return false
end

----------------------------------------------------------------
-- scheduler
--
-- One thread, time-driven, so the script keeps its cadence at 15 FPS and under a
-- background throttler instead of drifting with the frame rate. Jobs that move
-- the character share one lock with the steal loop.
----------------------------------------------------------------
local Jobs = {}

-- Every job used to start with nextAt = 0, so the first pass of the scheduler ran
-- ALL of them inside one frame: hatch, place, equip-best, the sell scan, the
-- upgrade checks, the anti-lag sweep and the first panel rebuild, back to back,
-- while the window was still being built. That pile-up was the freeze on startup.
-- Each job now opens on its own slot, and the loop below gives each one its own
-- frame, so the cost is spread instead of stacked.
local function job(name, interval, fn)
    local slot = #Jobs
    Jobs[slot + 1] = {
        name = name, interval = interval, fn = fn,
        nextAt = os.clock() + 0.45 * slot,
    }
end

local function withLock(fn, ...)
    if Runtime.lock or Runtime.stealing then return false end
    Runtime.lock = true
    local ok, err = pcall(fn, ...)
    Runtime.lock = false
    if not ok then Runtime.lastError = tostring(err) end
    return ok
end

job("upkeep", 2, function()
    enforceWalkSpeed()
    if Cfg.GodMode then
        local hum = humanoid()
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        if hum and not Runtime.conns.health then hardenCharacter() end
    end
    if not Runtime.instantReady and Cfg.MoveMode == "Instant" then
        Runtime.instantReady = killClientIntegrity()
    end
end)

job("eggs", 4, function()
    if not (Cfg.AutoHatch or Cfg.AutoPlace or Cfg.AutoEquipBest) then return end
    withLock(function()
        if Cfg.AutoHatch then
            if hatchReady() > 0 then markSellDirty() end
        end
        if Cfg.AutoPlace then placeEggs() end
        if Cfg.AutoEquipBest then equipBest() end
        -- placing is the one job that has to stand on the plot, so it always
        -- hands the anchor back before anything else looks at where we are
        toAnchor()
    end)
end)

job("bag", 6, function()
    if not Cfg.AutoSteal then return end
    if bagCount() >= EGG_BAG_CAP - 3 then withLock(relieveBag, true) end
end)

-- the queue is rebuilt on change, not on a timer, but a slow safety rescan keeps
-- it honest if something changed the inventory without telling us
job("sellScan", 4, function()
    -- keeps the panel honest whether or not selling is armed; only fires when the
    -- queue has run dry or the list has had time to drift
    if #sellQueue == 0 or os.clock() - sellLastScan > 12 then markSellDirty() end
end)

-- money-gated upgrades are checked every second: the whole point is that the
-- purchase happens the moment it is affordable, not on the next slow tick
job("progress", 1, function()
    if Cfg.AutoBaseUpgrade then pcall(baseUpgradeStep) end
    if Cfg.AutoTreadmillUp then pcall(treadmillUpgradeStep) end
end)

job("slowProgress", 15, function()
    if Cfg.AutoTrails then pcall(trailsStep) end
    if Cfg.AutoClaim then pcall(claimStep) end
    if Cfg.AutoFuse then withLock(fuseStep) end
end)

job("antilag", 30, function() pcall(antiLagSweep) end)
job("gc", 60, gcSweep)

task.spawn(function()
    while alive() do
        local now = os.clock()
        for _, j in ipairs(Jobs) do
            if not alive() then return end
            if now >= j.nextAt then
                j.nextAt = now + j.interval
                local ok, err = pcall(j.fn)
                if not ok then Runtime.lastError = j.name .. ": " .. tostring(err) end
                -- one job per frame: two of these landing together is the stutter
                RunService.Heartbeat:Wait()
                now = os.clock()
            end
        end
        task.wait(0.3)
    end
end)

-- seller thread: at most one request launched per tick, a few in flight at once.
-- That is the whole anti-stutter trick — the old code fired eight yields on the
-- same frame and the frame showed it.
task.spawn(function()
    local eggQueue, eggQueueAt = {}, 0

    -- Self-tuning pace.
    --
    -- Pacing our own requests was not enough on its own: the hitch does not come
    -- from sending them, it comes from the GAME reacting to items disappearing —
    -- its save module and its inventory panels redraw, and that cost is not ours
    -- to optimise away. So instead of guessing a safe rate, watch the frame clock
    -- and let it set the rate: back off the moment frames stretch, creep back up
    -- while they stay smooth. Fastest the client can take, never faster.
    local frameMax, frameConn = 0, nil
    local pace  = math.max(Cfg.SellPace or 0.05, 0.03)
    local lanes = math.clamp(Cfg.SellLanes or 3, 1, 6)
    local nextTune = 0
    -- what a quiet frame costs on THIS machine. A fixed millisecond threshold is
    -- useless here: one client alone runs at 10ms, a hundred boxed together run at
    -- 60ms and are perfectly healthy. Learned from windows where we sold nothing,
    -- so our own cost never pollutes the reference.
    local baseline, launched = nil, 0

    local function watchFrames(on)
        if on and not frameConn then
            frameConn = RunService.Heartbeat:Connect(function(dt)
                if dt > frameMax then frameMax = dt end
            end)
            Runtime.conns.frameWatch = frameConn
        elseif not on and frameConn then
            frameConn:Disconnect()
            frameConn = nil
            Runtime.conns.frameWatch = nil
            frameMax = 0
        end
    end

    while alive() do
        local paced = false

        -- the plan is rebuilt off the hot path and in chunks, and only when it is
        -- actually stale. the panel reads the same result, so nothing else in the
        -- script ever unpacks the inventory on a frame that matters.
        if sellDirty and sellFlight == 0 then
            local ok, err = pcall(refillSellQueue)
            if not ok then
                sellDirty = false
                Runtime.lastError = "sell: " .. tostring(err)
            end
        end

        if Cfg.AutoSellPets and #sellQueue > 0 then
            if sellFlight < lanes then
                local p = table.remove(sellQueue)
                if p then
                    sellFlight += 1
                    paced = true
                    launched += 1
                    task.spawn(function()
                        local ok = invoke(NET.ActiveAssets.REQUEST_SELL, p.uid)
                        sellFlight -= 1
                        if ok then
                            Runtime.stats.soldPets += 1
                            Runtime.sellEarned = (Runtime.sellEarned or 0) + (p.price or 0)
                        end
                    end)
                end
            end
        end

        -- eggs get the same treatment: one queue, rebuilt every few seconds, one
        -- sale per tick. never mid-steal — holding an egg tool while carrying a
        -- stolen one is asking for a dropped egg.
        if Cfg.AutoSellEggs and not Runtime.stealing then
            if #eggQueue == 0 and os.clock() - eggQueueAt > 3 then
                eggQueueAt = os.clock()
                local ok, plan = pcall(eggSellPlan)
                if ok and plan then
                    for i = #plan, 1, -1 do eggQueue[#eggQueue + 1] = plan[i] end
                end
            end
            if #eggQueue > 0 and not paced then
                local egg = table.remove(eggQueue)
                if egg and invoke(NET.Eggs.REQUEST_EQUIP_TOOL, egg.uid) then
                    fire(NET.AssetInventory.SELL_ASSET, { egg.uid })
                    Runtime.stats.soldEggs += 1
                    paced = true
                    launched += 1
                    if #eggQueue == 0 then
                        pcall(function() invoke(NET.Eggs.REQUEST_UNEQUIP_TOOL) end)
                        saveCache = nil
                    end
                end
            end
        elseif #eggQueue > 0 then
            table.clear(eggQueue)
        end

        -- measure whenever selling is armed, not only while the queue is busy: by
        -- the time work shows up the governor already knows how the client is doing
        local armed = Cfg.AutoSellPets or Cfg.AutoSellEggs
        watchFrames(armed)

        if armed and os.clock() >= nextTune then
            nextTune = os.clock() + 0.5
            local worst = frameMax
            frameMax = 0

            if worst > 0 then
                if launched == 0 then
                    -- an idle window: this is what "normal" costs right now
                    baseline = baseline and (baseline * 0.8 + worst * 0.2) or worst
                elseif baseline then
                    local floorPace = math.max(Cfg.SellPace or 0.05, 0.03)
                    local hitch  = worst > math.max(baseline * 1.8, baseline + 0.03)
                    local smooth = worst <= baseline * 1.25

                    if hitch then
                        pace  = math.min(pace * 1.7, 0.8)
                        lanes = 1
                    elseif smooth then
                        pace  = math.max(pace * 0.8, floorPace)
                        lanes = math.min(lanes + 1, math.clamp(Cfg.SellLanes or 3, 1, 6))
                    end
                end
            end

            launched = 0
            Runtime.sellPace     = pace
            Runtime.sellLanes    = lanes
            Runtime.sellWorstMs  = math.floor(worst * 1000)
            Runtime.sellBaseMs   = baseline and math.floor(baseline * 1000) or nil
        end

        task.wait(paced and pace or 0.25)
    end
end)

-- The client is pushed egg updates, so an empty map does not have to be polled:
-- every snapshot change bumps this counter and the loop below waits on it. A nest
-- that refills wakes the steal thread on the frame it lands instead of on the next
-- fixed tick, which is most of the difference when a narrow filter means we spend
-- more time waiting for eggs than taking them.
Runtime.eggTick = 0
for _, name in ipairs({ "AreaEggSnapshotUpdated", "AreaEggUpdated", "AreaEggRemoved" }) do
    local sig = EggCmds[name]
    if type(sig) == "table" and sig.Connect then
        local ok, conn = pcall(function()
            return sig:Connect(function() Runtime.eggTick += 1 end)
        end)
        if ok then Runtime.conns["egg_" .. name] = conn end
    end
end

local function waitForEggChange(timeout)
    local mark = Runtime.eggTick
    local t0 = os.clock()
    repeat
        task.wait(0.05)
    until Runtime.eggTick ~= mark or os.clock() - t0 > timeout or not alive() or not Cfg.AutoSteal
end

-- steal runs in its own thread and chains back to back: a whole trip costs less
-- than half a second, so waiting for a scheduler tick between eggs would waste
-- more time than the trip itself
task.spawn(function()
    while alive() do
        if Cfg.AutoSteal and not Runtime.stealing and not Runtime.lock then
            Runtime.stealing = true
            local misses, chain, empty = 0, 0, false
            repeat
                local ok, err = stealOnce()
                misses = ok and 0 or (misses + 1)
                chain += 1
                if not ok then
                    Runtime.lastError = tostring(err)
                    empty = tostring(err):find("ตัวกรอง") ~= nil
                    if tostring(err):find("เต็ม") then relieveBag(true) misses = 0 end
                    if empty then hopIfTrulyEmpty() end
                else
                    empty = false
                    -- an egg in hand ends the hop chain: this server works
                    if (Runtime.hopChain or 0) > 0 then
                        Runtime.hopChain = 0
                        writeHopState(0)
                    end
                    Runtime.hopStopped = false
                end
                -- hand the floor back every so often: with eggs always available the
                -- chain would otherwise never end and hatching would never get a turn
            until misses >= 3 or chain >= 20 or not Cfg.AutoSteal or not alive()
            Runtime.stealing = false
            toAnchor()

            if empty then
                -- nothing to take: sleep on the egg feed, not on a timer
                waitForEggChange(2)
            else
                -- a real window for the scheduler, not a race with it
                task.wait(0.35)
            end
        end
        task.wait(0.15)
    end
end)

