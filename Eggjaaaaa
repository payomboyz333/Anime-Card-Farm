----------------------------------------------------------------
-- client integrity
--
-- Measured on the 2026-08-15 build, because every assumption from the day before
-- turned out to be wrong:
--
-- * The corrector moved to ReplicatedFirst.IntroLoader.Analytics (Movement ->
--   Correction -> Rollback) and it Destroy()s its own ModuleScripts right after
--   requiring them, so require() answers "Requested module has been destroyed"
--   and the old hookfunction-on-ApplyTarget path can never reach them again.
--
-- * Cutting the Analytics connections off RunService does stop the pull-back --
--   and gets the account kicked for "Client integrity violation (Error Code:
--   267)" about a minute later, because the server watches for those reports and
--   notices when they stop. That path stays closed.
--
-- * The pull-back itself is not a Lua write we can intercept: with the whole
--   metatable instrumented, a teleport that snapped home produced no PivotTo, no
--   BulkMoveTo and no CFrame write from anyone but us. Rollback only zeroes our
--   velocity; the reposition arrives through replication, under Lua.
--
-- What it cannot survive is being outvoted. The corrector restores our position
-- once and then waits for its next sample, so a teleport that is re-asserted on
-- every Heartbeat wins every frame after the first: measured 90 frames of holding
-- a spot 200 studs away, and a full nest-to-bank steal in 0.54s. That is what
-- pin() below does, and it needs no hook at all.
--
-- The only thing worth hooking is the report: the corrector announces itself to
-- the server through "ClientCharacter: CorrectionStarted", one FireServer per
-- pull-back carrying just our name, and nothing else in the game fires it.
-- Dropping exactly that call leaves every heartbeat, ping and gameplay remote
-- alone -- which is the whole difference between this and the kick above.
----------------------------------------------------------------
local function muteCorrectionReport()
    if ENV.NyxCorrectionMuted then return true end
    if typeof(getrawmetatable) ~= "function" or typeof(setreadonly) ~= "function"
        or typeof(getnamecallmethod) ~= "function" then
        return false
    end

    local ok = pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)

        local oldNamecall = mt.__namecall
        local wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end

        mt.__namecall = wrap(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local okn, name = pcall(function() return self.Name end)
                if okn and type(name) == "string" and string.find(name, "CorrectionStarted", 1, true) then
                    return
                end
            end
            return oldNamecall(self, ...)
        end)

        setreadonly(mt, true)

        -- a reload has to be able to put the game's own metamethod back, or every
        -- reload wraps the previous wrapper
        ENV.NyxRestoreMT = function()
            pcall(function()
                setreadonly(mt, false)
                mt.__namecall = oldNamecall
                setreadonly(mt, true)
            end)
        end
    end)

    ENV.NyxCorrectionMuted = ok
    return ok
end

-- kept under the old name because the jobs and the panel both ask for it: arming
-- instant movement is now just muting that one report, and instant works with or
-- without it
local function killClientIntegrity()
    muteCorrectionReport()
    return true
end

