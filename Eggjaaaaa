                if Network and Network:FindFirstChild("Trails") and Network.Trails:FindFirstChild("RequestPurchase") then
                    Network.Trails.RequestPurchase:InvokeServer(Config.SelectedTrail)
                end
            end)
        end

        if Config.AutoUpgradePlot or Config.AutoUpgradeSpeed then
            pcall(function()
                local myPlot = getMyPlot()
                local searchArea = myPlot or Workspace
                for _, prompt in pairs(searchArea:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
                        local text = (prompt.ActionText .. " " .. prompt.ObjectText .. " " .. parentName):lower()
                        if Config.AutoUpgradePlot and (text:find("plot") or text:find("pen") or text:find("upgrade")) then
                            fireproximityprompt(prompt)
                        end
                        if Config.AutoUpgradeSpeed and (text:find("speed") or text:find("treadmill") or text:find("multiplier")) then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end)
        end
    end
end)

