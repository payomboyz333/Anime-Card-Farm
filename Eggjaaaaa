-- Fly Logic (Conflict-Free with WalkSpeed)
local flyBodyVelocity = nil
local flyBodyGyro = nil

local function ToggleFly()
    local root = getRootPart()
    local hum = getHumanoid()
    if not root or not hum then return end

    if Config.FlyToggle then
        hum.PlatformStand = true
        pcall(function()
            if flyBodyVelocity then flyBodyVelocity:Destroy() end
            if flyBodyGyro then flyBodyGyro:Destroy() end
        end)

        flyBodyVelocity = Instance.new("BodyVelocity")
        flyBodyGyro = Instance.new("BodyGyro")

        flyBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBodyVelocity.Velocity = Vector3.zero
        flyBodyVelocity.Parent = root

        flyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBodyGyro.CFrame = root.CFrame
        flyBodyGyro.Parent = root

        task.spawn(function()
            while Config.FlyToggle do
                local currentRoot = getRootPart()
                local currentHum = getHumanoid()
                if not currentRoot or not currentHum then break end
                currentHum.PlatformStand = true

                local Camera = Workspace.CurrentCamera
                local moveDir = Vector3.zero

                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                flyBodyVelocity.Velocity = moveDir * Config.FlySpeed
                flyBodyGyro.CFrame = Camera.CFrame
                task.wait()
            end
            pcall(function()
                if flyBodyVelocity then flyBodyVelocity:Destroy() end
                if flyBodyGyro then flyBodyGyro:Destroy() end
                local h = getHumanoid()
                if h then h.PlatformStand = false end
            end)
        end)
    else
        pcall(function()
            if flyBodyVelocity then flyBodyVelocity:Destroy() end
            if flyBodyGyro then flyBodyGyro:Destroy() end
            if hum then hum.PlatformStand = false end
        end)
    end
end

-- Multi-thread WalkSpeed & JumpPower Enforcer (Anti-Speed Reset Bypass)
local function enforceMovementStats()
    local hum = getHumanoid()
    if not hum then return end

    if Config.WalkSpeedToggle and not Config.FlyToggle then
        if hum.WalkSpeed ~= Config.WalkSpeedValue then
            hum.WalkSpeed = Config.WalkSpeedValue
        end
    end

    if Config.JumpPowerToggle and not Config.FlyToggle then
        hum.UseJumpPower = true
        if hum.JumpPower ~= Config.JumpPowerValue then
            hum.JumpPower = Config.JumpPowerValue
        end
    end
end

RunService.Heartbeat:Connect(enforceMovementStats)
RunService.Stepped:Connect(enforceMovementStats)
RunService.RenderStepped:Connect(enforceMovementStats)

local function hookHumanoidProperties(hum)
    if not hum then return end
    pcall(function()
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if Config.WalkSpeedToggle and not Config.FlyToggle and hum.WalkSpeed ~= Config.WalkSpeedValue then
                hum.WalkSpeed = Config.WalkSpeedValue
            end
        end)
        hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if Config.JumpPowerToggle and not Config.FlyToggle and hum.JumpPower ~= Config.JumpPowerValue then
                hum.JumpPower = Config.JumpPowerValue
            end
        end)
    end)
end

