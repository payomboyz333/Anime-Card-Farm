-- Helper: Find Local Player's Plot in Workspace
local function getMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        for _, desc in pairs(plot:GetDescendants()) do
            if desc:IsA("TextLabel") and (desc.Text == LocalPlayer.Name or desc.Text == LocalPlayer.DisplayName) then
                return plot
            end
        end
    end
    return nil
end

-- Helper: Check if Rarity meets minimum filter requirement
local function MeetsRarityFilter(eggRarity)
    if not eggRarity then return true end
    local minLevel = RarityLevels[Config.MinRarityFilter] or 1
    local currentLevel = RarityLevels[eggRarity] or 1
    return currentLevel >= minLevel
end

-- Auto Steal Eggs from Map Loop
task.spawn(function()
    while true do
        task.wait(Config.StealDelay)
        if Config.AutoStealMapEggs then
            pcall(function()
                local root = getRootPart()
                
                -- 1. Scan ProximityPrompts & Egg Nests in Map
                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local text = (prompt.ActionText .. " " .. prompt.ObjectText):lower()
                        if text:find("steal") or text:find("carry") or text:find("egg") or text:find("take") or text:find("grab") then
                            if Config.AutoTPToMapEggs and root and prompt.Parent and prompt.Parent:IsA("BasePart") then
                                root.CFrame = prompt.Parent.CFrame * CFrame.new(0, 2, 0)
                                task.wait(0.05)
                            end
                            fireproximityprompt(prompt)
                        end
                    end
                end
                
                -- 2. Call Remote Event for Map Area Egg Carry
                if Network and Network:FindFirstChild("Eggs") and Network.Eggs:FindFirstChild("RequestAreaEggCarry") then
                    Network.Eggs.RequestAreaEggCarry:InvokeServer()
                end
            end)
        end
    end
end)

