-- Helper: Find Local Player's Plot in Workspace
local function getMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        for _, desc in pairs(plot:GetDescendants()) do
            if desc:IsA("TextLabel") and (desc.Text == LocalPlayer.Name or desc.Text == LocalPlayer.DisplayName) then
                return plot
            end
        end
    end
    return nil
end

-- Helper: Check if LocalPlayer is standing inside or near their Plot
local function isAtPlot()
    local plot = getMyPlot()
    if not plot then return false end
    local root = getRootPart()
    if not root then return false end

    local targetPart = plot:FindFirstChild("SpawnPoint", true) 
        or plot:FindFirstChild("PlotSign", true) 
        or plot:FindFirstChild("PlayerPlotSign", true)
        or plot:FindFirstChild("Spawn", true)
        or plot:FindFirstChild("Gate", true)

    if targetPart then
        local targetPos = targetPart:IsA("Model") and targetPart:GetPivot().Position or targetPart.Position
        return (root.Position - targetPos).Magnitude <= 35
    end
    return false
end

-- Helper: Smart Teleport to Local Player's Plot / Home Base
local function teleportToMyPlot()
    local plot = getMyPlot()
    if not plot then return false end
    local root = getRootPart()
    if not root then return false end

    local targetPart = plot:FindFirstChild("SpawnPoint", true) 
        or plot:FindFirstChild("PlotSign", true) 
        or plot:FindFirstChild("PlayerPlotSign", true)
        or plot:FindFirstChild("Spawn", true)
        or plot:FindFirstChild("Gate", true)

    if targetPart then
        local targetCFrame = targetPart:IsA("Model") and targetPart:GetPivot() or targetPart.CFrame
        root.CFrame = targetCFrame * CFrame.new(0, 3, 0)
        return true
    else
        local primary = plot.PrimaryPart or plot:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            root.CFrame = primary.CFrame * CFrame.new(0, 3, 0)
            return true
        end
    end
    return false
end

local lastPlotTPTime = 0
local function smartTPToPlot()
    if isAtPlot() then return true end -- Already at plot! DO NOT TP!
    
    -- Anti-Spam Cooldown (2 Seconds)
    if os.clock() - lastPlotTPTime < 2.0 then return false end
    lastPlotTPTime = os.clock()
    
    return teleportToMyPlot()
end

-- Helper: Rarity Parser
local function parseEggRarity(rarityStr)
    if not rarityStr then return "Common" end
    local str = tostring(rarityStr):lower()
    if str:find("divine") then return "Divine" end
    if str:find("mythic") then return "Mythic" end
    if str:find("legendary") or str:find("legend") then return "Legendary" end
    if str:find("epic") then return "Epic" end
    if str:find("rare") then return "Rare" end
    if str:find("uncommon") then return "Uncommon" end
    return "Common"
end

-- Helper: Check Carried Egg in Character or Backpack
local function getCarriedEggInfo()
    local char = getCharacter()
    if not char then return nil end

    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") or item:IsA("Model") then
            local name = item.Name:lower()
            if name:find("egg") or item:FindFirstChild("Egg") or item:GetAttribute("Rarity") or item:FindFirstChild("Rarity") then
                local rarity = item:GetAttribute("Rarity") or (item:FindFirstChild("Rarity") and item.Rarity.Value) or item.Name
                return { Instance = item, Rarity = parseEggRarity(rarity) }
            end
        end
    end

    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        local name = item.Name:lower()
        if name:find("egg") or item:FindFirstChild("Egg") or item:GetAttribute("Rarity") or item:FindFirstChild("Rarity") then
            local rarity = item:GetAttribute("Rarity") or (item:FindFirstChild("Rarity") and item.Rarity.Value) or item.Name
            return { Instance = item, Rarity = parseEggRarity(rarity) }
        end
    end

    return nil
end

local function MeetsPlaceFilter(eggRarityStr)
    local eggRarity = parseEggRarity(eggRarityStr)
    local minLevel = RarityLevels[Config.MinRarityPlaceFilter] or 1
    local currentLevel = RarityLevels[eggRarity] or 1
    return currentLevel >= minLevel
end

local function MeetsHatchFilter(eggRarityStr)
    local eggRarity = parseEggRarity(eggRarityStr)
    local minLevel = RarityLevels[Config.MinRarityHatchFilter] or 1
    local currentLevel = RarityLevels[eggRarity] or 1
    return currentLevel >= minLevel
end

