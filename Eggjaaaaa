ENV.NyxCleanup = function()
    for _, c in pairs(Runtime.conns) do pcall(function() c:Disconnect() end) end
    Runtime.conns = {}
    -- a pin left running would keep teleporting the character to a spot the next
    -- session knows nothing about
    for _, c in ipairs(Runtime.pinConns or {}) do
        pcall(function() c:Disconnect() end)
    end
    Runtime.pinConns = nil
    -- put the game's own metamethod back before the next copy of this file
    -- installs its own, or every reload wraps the previous wrapper
    if ENV.NyxRestoreMT then
        pcall(ENV.NyxRestoreMT)
        ENV.NyxRestoreMT = nil
        ENV.NyxCorrectionMuted = false
    end
    -- the window, not the library: reloading used to stack a new panel on top of
    -- every old one because the library has no Destroy of its own
    pcall(function() if UIWindow then UIWindow:Destroy() end end)
    UIWindow = nil
    pcall(function() if Runtime.floatGui then Runtime.floatGui:Destroy() end end)
    Runtime.floatGui, Runtime.floatIcon = nil, nil
end

