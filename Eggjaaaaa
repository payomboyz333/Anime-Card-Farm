local function areaEggRecords()
    local ok, snap = pcall(EggCmds.GetAreaEggSnapshot)
    if not ok or type(snap) ~= "table" then return {} end
    return snap.Records or snap
end

-- Every egg row carries the pet it will hatch into as AssetCategory, so what is
-- sitting in the bag or growing in the pen is knowable before it cracks. Growth
-- time is derived from the placement stamp rather than EggItemUtil's own helper,
-- which asserts on the shapes we have to hand.
local function eggRoster()
    local recs = myRuntimeRecords()
    local now  = os.time()
    local list = {}

    for uid, raw in pairs(eggInventory()) do
        if type(raw) == "table" and raw.AssetCategory then
            local rec    = recs[uid]
            local placed = rec and rec.Placement or nil
            local ready, remain = false, nil

            if placed then
                local ok, r = pcall(EggCmds.IsLocalEggReady, uid)
                ready = ok and r == true

                if not ready and EggUtil and EggUtil.GetGrowthDuration then
                    local okd, dur = pcall(EggUtil.GetGrowthDuration, rec)
                    if okd and tonumber(dur) then
                        local credit = (tonumber(placed.GrowthCreditSeconds) or 0)
                            + (tonumber(placed.NightGrowthCreditSeconds) or 0)
                        local elapsed = now - (tonumber(placed.PlacedAt) or now) + credit
                        remain = math.max(0, math.floor(tonumber(dur) - elapsed))
                    end
                end
            end

            list[#list + 1] = {
                uid = uid, cat = raw.AssetCategory, rarity = rarityOf(raw.AssetCategory),
                placed = placed ~= nil, ready = ready, remain = remain,
            }
        end
    end
    return list
end

local function clockText(sec)
    if not sec then return "?" end
    if sec <= 0 then return "พร้อม" end
    if sec < 60 then return ("%ds"):format(sec) end
    if sec < 3600 then return ("%dm"):format(math.floor(sec / 60)) end
    return ("%dh %dm"):format(math.floor(sec / 3600), math.floor(sec % 3600 / 60))
end

local function unplacedEggs()
    local recs = myRuntimeRecords()
    local out = {}
    for uid, raw in pairs(eggInventory()) do
        if not (recs[uid] and recs[uid].Placement) and type(raw) == "table" and raw.AssetCategory then
            local price = 0
            if EggUtil and EggUtil.GetSellPrice then
                local ok, p = pcall(EggUtil.GetSellPrice, raw)
                if ok then price = tonumber(p) or 0 end
            end
            out[#out + 1] = { uid = uid, cat = raw.AssetCategory, rarity = rarityOf(raw.AssetCategory), price = price }
        end
    end
    return out
end

local function occupiedSpots()
    local spots = {}
    for _, rec in pairs(myRuntimeRecords()) do
        if rec.Placement and rec.Placement.LocalCFrame then
            table.insert(spots, rec.Placement.LocalCFrame.Position)
        end
    end
    return spots
end

local function nextFreeSpot(taken)
    local pd = plotData()
    if not pd or not pd.PetArea or not pd.CenterPoint then return nil end
    local pa, center = pd.PetArea, pd.CenterPoint.CFrame
    local halfX = math.max(pa.Size.X * 0.5 - 5, 2)
    local halfZ = math.max(pa.Size.Z * 0.5 - 5, 2)
    local spacing = 5

    for radius = 0, math.max(halfX, halfZ), spacing do
        for dx = -radius, radius, spacing do
            for dz = -radius, radius, spacing do
                if math.abs(dx) == radius or math.abs(dz) == radius or radius == 0 then
                    if math.abs(dx) <= halfX and math.abs(dz) <= halfZ then
                        local world = pa.CFrame * CFrame.new(dx, 0, dz)
                        local flat  = CFrame.new(world.Position.X, pa.CFrame.Position.Y, world.Position.Z)
                        local lcf   = center:ToObjectSpace(flat)
                        local free  = true
                        for _, p in ipairs(taken) do
                            if (Vector3.new(p.X, 0, p.Z) - Vector3.new(lcf.X, 0, lcf.Z)).Magnitude < spacing - 0.5 then
                                free = false break
                            end
                        end
                        if free then return lcf end
                    end
                end
            end
        end
    end
    return nil
end

local function atHome()
    local root = hrp()
    if not root then return false end
    local ok, inside = pcall(PlotCmds.IsWorldPositionWithinLocalPlotBounds, root.Position)
    return ok and inside == true
end

local function goHome()
    local pd = plotData()
    if not pd or not pd.PetArea then return false end
    return moveTo(pd.PetArea.CFrame.Position + Vector3.new(0, 4, 0))
end

-- hatching answers from anywhere on the map, so this never leaves the anchor
local function hatchReady()
    local hatched = 0
    for uid, rec in pairs(myRuntimeRecords()) do
        if rec.Placement then
            local ok, ready = pcall(EggCmds.IsLocalEggReady, uid)
            if ok and ready then
                if EggCmds.RequestHatchEgg(uid) then
                    task.wait(0.15)
                    if EggCmds.RequestCompleteHatchEgg(uid) then
                        hatched += 1
                        Runtime.stats.hatched += 1
                        logLine("hatch", ("ฟัก %s"):format(rec.AssetCategory or "?"))
                    end
                end
            end
        end
    end
    return hatched
end

local function placeEggs()
    local queue = {}
    for _, egg in ipairs(unplacedEggs()) do
        if Cfg.PlaceRarities[egg.rarity] then queue[#queue + 1] = egg end
    end
    if #queue == 0 then return 0 end
    table.sort(queue, function(a, b) return rankOf(a.cat) > rankOf(b.cat) end)

    -- Placing is a "you must be closer" check on every single egg, so standing on
    -- the plot has to survive the whole batch, not just the trip out. The plot spot
    -- is pinned for the duration: one teleport, twenty placements, no walking.
    local unpin
    local function release() if unpin then local f = unpin unpin = nil pcall(f) end end

    if instantOK() then
        local pd = plotData()
        local spot = pd and pd.PetArea and (pd.PetArea.CFrame.Position + Vector3.new(0, 4, 0))
        if spot then
            unpin = pin(spot)
            waitPinned(spot, 8, 0.35)
        end
    elseif not atHome() then
        goHome()
    end

    local taken, placed = occupiedSpots(), 0
    for _, egg in ipairs(queue) do
        local lcf = nextFreeSpot(taken)
        if not lcf then break end
        local ok, err = EggCmds.RequestPlaceEgg(egg.uid, lcf)
        if ok then
            placed += 1
            table.insert(taken, lcf.Position)
            task.wait(0.08)
        elseif tostring(err):find("closer") then
            table.insert(taken, lcf.Position)
        else
            break
        end
    end

    release()
    if placed > 0 then toAnchor() end
    return placed
end

-- selling an egg needs it in our hands first: equip the tool, then fire the sale.
-- no stand, no prompt, works from the anchor.
local function eggSellPlan()
    local plan = {}
    local limit = tonumber(Cfg.SellEggBelow) or 0
    for _, egg in ipairs(unplacedEggs()) do
        local byRarity = Cfg.SellEggRarities[egg.rarity] == true
        local byPrice  = limit > 0 and egg.price < limit
        if byRarity or byPrice then plan[#plan + 1] = egg end
    end
    table.sort(plan, function(a, b) return a.price < b.price end)
    return plan
end

-- one egg per call by default: the seller thread paces these the same way it
-- paces pets, so a bag of a hundred never lands on a single frame
local function sellEggsOnce(count)
    local plan = eggSellPlan()
    if #plan == 0 then return 0 end

    local sold = 0
    for i = 1, math.min(count or 1, #plan) do
        local egg = plan[i]
        if invoke(NET.Eggs.REQUEST_EQUIP_TOOL, egg.uid) then
            fire(NET.AssetInventory.SELL_ASSET, { egg.uid })
            sold += 1
            Runtime.stats.soldEggs += 1
            task.wait(0.04)
        end
    end
    if sold > 0 then
        pcall(function() invoke(NET.Eggs.REQUEST_UNEQUIP_TOOL) end)
        saveCache = nil
        logLine("sell", ("ขายไข่ %d ใบ"):format(sold))
    end
    return sold
end

local function sellEggs(maxCount)
    local total = 0
    for _ = 1, math.min(maxCount or (Cfg.SellMaxPerRun or 60), 200) do
        local n = sellEggsOnce(1)
        if n == 0 then break end
        total += n
        task.wait(0.04)
    end
    return total
end

