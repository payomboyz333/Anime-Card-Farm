-- Auto Hatch Egg Loop (Smart Hatch via PlacedEggRenders & Plot Nests with Rarity Filter)
task.spawn(function()
    while true do
        task.wait(Config.HatchDelay)
        if Config.AutoHatchEgg then
            pcall(function()
                local myPlot = getMyPlot()
                local root = getRootPart()

                -- Smart TP Home ONLY if far away and enabled
                if Config.AutoTPHomeToPlace then
                    smartTPToPlot()
                end

                -- 1. Direct Hatching via Workspace.PlacedEggRenders using Egg UUID (100% Reliable Remote)
                local placedEggFolder = Workspace:FindFirstChild("PlacedEggRenders")
                local userIdStr = tostring(LocalPlayer.UserId)

                if placedEggFolder then
                    for _, eggModel in pairs(placedEggFolder:GetChildren()) do
                        local parts = eggModel.Name:split("_")
                        local isMyEgg = (parts[1] == userIdStr) or (myPlot and eggModel:IsDescendantOf(myPlot))
                        if isMyEgg then
                            local eggId = parts[2] or eggModel.Name
                            local rarity = eggModel:GetAttribute("Rarity") or (eggModel:FindFirstChild("Rarity") and eggModel.Rarity.Value) or eggModel.Name
                            
                            if MeetsHatchFilter(rarity) then
                                if Network and Network:FindFirstChild("Eggs") then
                                    if Network.Eggs:FindFirstChild("RequestHatchEgg") then
                                        Network.Eggs.RequestHatchEgg:InvokeServer(eggId)
                                    end
                                    if Network.Eggs:FindFirstChild("RequestCompleteHatchEgg") then
                                        Network.Eggs.RequestCompleteHatchEgg:InvokeServer(eggId)
                                    end
                                end

                                -- Fire ProximityPrompts inside egg model
                                for _, prompt in pairs(eggModel:GetDescendants()) do
                                    if prompt:IsA("ProximityPrompt") then
                                        if root and prompt.Parent and prompt.Parent:IsA("BasePart") then
                                            root.CFrame = prompt.Parent.CFrame * CFrame.new(0, 3, 0)
                                        end
                                        fireproximityprompt(prompt, 0)
                                    end
                                end
                            end
                        end
                    end
                end

                -- 2. Fallback scan on Plot Nests & Prompts
                if myPlot then
                    for _, prompt in pairs(myPlot:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            local text = (prompt.ActionText .. " " .. prompt.ObjectText):lower()
                            if text:find("hatch") or text:find("open") or text:find("claim") or text:find("crack") then
