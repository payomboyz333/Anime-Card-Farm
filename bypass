-- ═══════════════════════════════════════════════════════════════

local APIHooks = {
    hookedFunctions = {},
    originalRefs = {},
    integrityChecks = 0,
}

local function maskAPIHook(fn, wrapper)
    -- Store original reference safely
    local fnRef = fn
    APIHooks.originalRefs[fn] = fnRef
    APIHooks.hookedFunctions[fn] = wrapper
    
    -- Return wrapper that looks like original
    return wrapper
end

local function sanitizeHookSignature(fn)
    -- Make hooked function look like original
    if type(fn) ~= "function" then return fn end
    
    local info = debug.getinfo(fn, "S")
    if not info then return fn end
    
    -- Create wrapper with matching signature characteristics
    local wrapper = function(...)
        return fn(...)
    end
    
    return wrapper
end

local function verifyAPIIntegrity()
    -- Periodically verify our hooks haven't been detected
    APIHooks.integrityChecks = APIHooks.integrityChecks + 1
    
    -- If check count is suspicious, add noise
