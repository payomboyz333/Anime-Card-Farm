-- §0.1  BAC-7518 — Filesystem & IO Operation Monitoring
-- ═══════════════════════════════════════════════════════════════
-- BAC-7518 checks:
--   • File read/write patterns (writefile, readfile, etc.)
--   • Folder creation anomalies
--   • File timestamp consistency
--   • Path traversal patterns
--   • I/O operation frequency
-- ═══════════════════════════════════════════════════════════════

local FileSystem = {
    operations = {},
    lastOpTime = 0,
    fileCache = {},
    maxHistory = 25,
}

local function maskFileOperation(opType, path)
    -- Record operation with timestamp
    table.insert(FileSystem.operations, {
        type = opType,
        path = path,
        time = tick(),
    })
    while #FileSystem.operations > FileSystem.maxHistory do
        table.remove(FileSystem.operations, 1)
    end
    FileSystem.lastOpTime = tick()
end

local function randomizeFileTimestamps()
    -- Create fake file operations to pollute timing analysis
    local fakePaths = {
        "temp_" .. math.random(1000, 9999) .. ".tmp",
        "cache_" .. os.time() .. ".dat",
        "log_" .. math.random(100, 999) .. ".txt",
    }
    for _, path in ipairs(fakePaths) do
        maskFileOperation("read", path)
    end
end

local function sanitizeIOFrequency()
    -- Add random delays between I/O operations
    local now = tick()
    local recentOps = 0
    for i = #FileSystem.operations, 1, -1 do
        if now - FileSystem.operations[i].time < 2.0 then
            recentOps = recentOps + 1
        else
            break
        end
    end
    -- If too many recent ops, return delay
    if recentOps > 8 then
        return math.random() * 0.15 + 0.05
    end
    return 0
end

