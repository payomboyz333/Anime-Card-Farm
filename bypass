-- §2  BAC-4511 — Behavior Analysis
-- ═══════════════════════════════════════════════════════════════
BehaviorProfile = {
    reactionTime = { mean = 250, stdDev = 80 },
    actionDuration = { mean = 1.2, stdDev = 0.4 },
    actionInterval = { mean = 2.5, stdDev = 1.0 },
}

ActionTimer = {
    lastTimes = {},
    maxHistory = 20,
}

local function recordAction(actionType)
    local now = tick()
    table.insert(ActionTimer.lastTimes, { type = actionType, time = now })
    while #ActionTimer.lastTimes > ActionTimer.maxHistory do
        table.remove(ActionTimer.lastTimes, 1)
    end
end

local function getNaturalDelay(minDelay, maxDelay)
    minDelay = minDelay or 0.1
    maxDelay = maxDelay or 0.5
    local now = tick()
    local recentCount = 0
    for i = #ActionTimer.lastTimes, 1, -1 do
        if now - ActionTimer.lastTimes[i].time < 1.0 then
            recentCount = recentCount + 1
        else
            break
        end
    end
    if recentCount > 10 then
        return maxDelay * 0.8 + math.random() * maxDelay * 0.4
    end
    local avg = (minDelay + maxDelay) / 2
    local variance = (maxDelay - minDelay) / 4
    local u1 = math.random()
    local u2 = math.random()
    local normal = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
    return math.clamp(avg + normal * variance, minDelay, maxDelay)
end

