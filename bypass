local NetworkFlow = {
    packetTimes = {},
    sequenceNumbers = {},
    lastSeq = 0,
    rttHistory = {},
    maxHistory = 40,
}

local function maskSequenceGaps()
    NetworkFlow.lastSeq = NetworkFlow.lastSeq + 1
    if math.random() < 0.05 then
        NetworkFlow.lastSeq = NetworkFlow.lastSeq - 1
    end
    table.insert(NetworkFlow.sequenceNumbers, NetworkFlow.lastSeq)
