-- §4  BAC-5695 — GC & Hook Camouflage
-- ═══════════════════════════════════════════════════════════════
local function bac5695_bypass(targetConstant)
    targetConstant = targetConstant or "X-16"
    if not BYPASS.gc then return nil end

    local found = nil
    local ok, gcTable = pcall(BYPASS.gc)
    if not ok or type(gcTable) ~= "table" then return nil end

    for _, obj in ipairs(gcTable) do
        if type(obj) == "function" then
            local isLua = false
            if BYPASS.islclosure then
                isLua = pcall(BYPASS.islclosure, obj) == true
            end
            if isLua then
                local consts = BYPASS.constants(obj)
                if type(consts) == "table" then
                    for _, c in ipairs(consts) do
                        if c == targetConstant then
                            found = obj
                            break
                        end
                    end
                end
            end
            if found then break end
        end
    end

    if not found then return nil end

    local original = found
    local hooked = function(p1, p2, p3, p4, p5)
        for lvl = 1, 5 do
            local info = debug.getinfo(lvl, "f")
            if info and info.func == hooked then
                local stack = debug.getstack(lvl)
                for idx, val in pairs(stack) do
                    if val == targetConstant then
                        pcall(function() debug.setstack(lvl, idx, nil) end)
                    end
                end
            end
        end
        return original(p1, p2, p3, p4, p5)
    end

    if BYPASS.hookfn then
        local protected = BYPASS.protectUpvalues(hooked)
        pcall(function() BYPASS.hookfn(found, protected) end)
    end
    return hooked
end

