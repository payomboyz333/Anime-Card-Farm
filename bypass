-- §5  BAC-4697 — Constant Sanitizer
-- ═══════════════════════════════════════════════════════════════
local function bac4697_sanitize(fn)
    local consts = BYPASS.constants(fn)
    if not consts then return end
    for i, v in ipairs(consts) do
        if type(v) == "string" then
            if v:match("^BAC") or v:match("^Byfron") or v:match("^X-%d+") then
                consts[i] = string.rep("\0", #v)
            end
        end
    end
    return consts
end

