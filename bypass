MemoryFlow = {
    allocCount = 0,
    lastAllocTime = 0,
    connectionCount = 0,
    yieldHistory = {},
    maxHistory = 30,
}

local function randomizeMemoryPattern()
    local chunks = {}
    for i = 1, math.random(5, 15) do
        chunks[i] = string.rep("\0", math.random(100, 500))
    end
    local order = {}
    for i = 1, #chunks do order[i] = i end
    for i = #order, 2, -1 do
        local j = math.random(i)
        order[i], order[j] = order[j], order[i]
    end
    for _, idx in ipairs(order) do
        chunks[idx] = nil
    end
    local memBefore = gcinfo()
    for i = 1, 3 do chunks[i] = nil end
    local memAfter = gcinfo()
    MemoryFlow.allocCount = MemoryFlow.allocCount + (memBefore - memAfter)
end

local function maskConnectionCount()
    local guiConns = 0
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            guiConns = guiConns + #gui:GetChildren()
        end
    end
    MemoryFlow.connectionCount = guiConns
    return guiConns
end

local function sanitizeYieldPattern()
    local now = tick()
    table.insert(MemoryFlow.yieldHistory, now)
    while #MemoryFlow.yieldHistory > MemoryFlow.maxHistory do
        table.remove(MemoryFlow.yieldHistory, 1)
    end
    if #MemoryFlow.yieldHistory >= 5 then
        local intervals = {}
        for i = 2, #MemoryFlow.yieldHistory do
            intervals[i-1] = MemoryFlow.yieldHistory[i] - MemoryFlow.yieldHistory[i-1]
        end
        local sum = 0
        for _, v in ipairs(intervals) do sum = sum + v end
        local avg = sum / #intervals
        local variance = 0
        for _, v in ipairs(intervals) do
            variance = variance + (v - avg) * (v - avg)
        end
        variance = variance / #intervals
        if variance < 0.001 then
            return math.random() * 0.05
        end
    end
    return 0
end

local function maskTableMetamethods(tbl)
    local mt = getmetatable(tbl)
    if not mt then return tbl end
    local cleanMt = {}
    for k, v in pairs(mt) do
        if k ~= "__index" and k ~= "__newindex" and k ~= "__metatable" then
            cleanMt[k] = v
        end
    end
    local proxy = {}
    setmetatable(proxy, cleanMt)
    local proxyMt = getmetatable(proxy)
    proxyMt.__index = function(_, k)
        return tbl[k]
    end
    proxyMt.__newindex = function(_, k, v)
        tbl[k] = v
    end
    return proxy
end

