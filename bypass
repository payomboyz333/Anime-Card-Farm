-- §3  ENVIRONMENT HARDENING
-- ═══════════════════════════════════════════════════════════════
local function hardenEnv()
    local _gc = rawget(_G, "getgc")
    local _constants = rawget(_G, "getconstants")
    local _hookfn = rawget(_G, "hookfunction")
    local _islclosure = rawget(_G, "islclosure")

    local function safeConstants(fn)
        if not _constants or not fn then return {} end
        local ok, consts = pcall(_constants, fn)
        if not ok then return {} end
        local copy = {}
        for i = 1, #consts do
            local v = consts[i]
            if type(v) == "string" and #v > 2 then
                copy[i] = v
            end
        end
        return copy
    end

    local lastFire = 0
    local function throttledFire(remote, arg1, arg2, arg3, arg4, arg5)
        local now = tick()
        local delay = getNaturalDelay(0.03, 0.08)
        if now - lastFire < delay then
            task.wait(delay - (now - lastFire))
        end
        lastFire = tick()
        local args = {arg1, arg2, arg3, arg4, arg5}
        local n = 0
        for i = 1, 5 do if args[i] ~= nil then n = i end end
        args[n + 1] = math.random(0, 1)
        return pcall(function() remote:FireServer(table.unpack(args, 1, n + 1)) end)
    end

    local function protectUpvalues(fn)
        if not fn then return fn end
        local mt = getmetatable(fn) or {}
        local originalIndex = mt.__index
        mt.__index = function(t, k)
            if k == "getupvalue" or k == "setupvalue" then
                return function(f, i, v)
                    if v ~= nil then return true end
                    return nil
                end
            end
            if originalIndex then return originalIndex(t, k) end
            return rawget(t, k)
        end
        setmetatable(fn, mt)
        return fn
    end

    return {
        gc = _gc,
        constants = safeConstants,
        hookfn = _hookfn,
        islclosure = _islclosure,
        fire = throttledFire,
        protectUpvalues = protectUpvalues,
    }
end

local BYPASS = hardenEnv()

