local function sanitizeRTT()
    local fakeRTT = math.random(30, 150)
    table.insert(NetworkFlow.rttHistory, fakeRTT)
    while #NetworkFlow.rttHistory > NetworkFlow.maxHistory do
        table.remove(NetworkFlow.rttHistory, 1)
    end
end

local function generateNaturalPacketDelay()
    local baseDelay = 0.05
    local jitter = math.random() * 0.03
    local now = tick()
    local recentPackets = 0
    for i = #NetworkFlow.packetTimes, 1, -1 do
        if now - NetworkFlow.packetTimes[i] < 1.0 then
            recentPackets = recentPackets + 1
        else
            break
        end
    end
    if recentPackets > 15 then
        baseDelay = baseDelay * 1.5
    end
    table.insert(NetworkFlow.packetTimes, now)
    while #NetworkFlow.packetTimes > NetworkFlow.maxHistory do
        table.remove(NetworkFlow.packetTimes, 1)
    end
    return baseDelay + jitter
end

