local function LoadSavedKey()
    local saved = ""
    pcall(function()
        if isfile and isfile(LuarmorConfig.SavedKeyFile) and readfile then
            saved = readfile(LuarmorConfig.SavedKeyFile)
        end
    end)
    return saved:gsub("%s+", "")
end

local function ShowToast(title, message, isError)
    pcall(function()
        local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
        local ToastGui = Instance.new("ScreenGui")
        ToastGui.Name = "PayomboyZ_Toast"
        ToastGui.ResetOnSpawn = false
        pcall(function() ToastGui.Parent = CoreGui end)
        if not ToastGui.Parent then ToastGui.Parent = PlayerGui end

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(0, 360, 0, 58)
        Frame.Position = UDim2.new(1, -380, 0, 20)
        Frame.BackgroundColor3 = Color3.fromRGB(15, 3, 6)
        Frame.BorderSizePixel = 0
        Frame.Parent = ToastGui

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0, 7)
        Corner.Parent = Frame

        local Stroke = Instance.new("UIStroke")
        Stroke.Thickness = 2
        Stroke.Parent = Frame

        -- RGB สำหรับ Toast
        task.spawn(function()
            while ToastGui.Parent do
                local hue = (tick() * 0.8) % 1
                Stroke.Color = Color3.fromHSV(hue, 1, 1)
                task.wait()
            end
        end)

        local TText = Instance.new("TextLabel")
        TText.Size = UDim2.new(1, -20, 0, 20)
        TText.Position = UDim2.new(0, 10, 0, 6)
        TText.BackgroundTransparency = 1
        TText.Text = title
        TText.Font = Enum.Font.GothamBold
        TText.TextSize = 13
        TText.TextColor3 = Color3.fromRGB(255, 255, 255)
        TText.TextXAlignment = Enum.TextXAlignment.Left
        TText.Parent = Frame

        local MText = Instance.new("TextLabel")
        MText.Size = UDim2.new(1, -20, 0, 18)
        MText.Position = UDim2.new(0, 10, 0, 29)
        MText.BackgroundTransparency = 1
        MText.Text = message
        MText.Font = Enum.Font.Gotham
        MText.TextSize = 11
        MText.TextColor3 = Color3.fromRGB(255, 220, 220)
        MText.TextXAlignment = Enum.TextXAlignment.Left
        MText.Parent = Frame

        task.delay(4, function()
            ToastGui:Destroy()
        end)
    end)
end

local function PassToKeyChecker(userKey)
    if not userKey or userKey == "" then return end
    userKey = userKey:gsub("%s+", "")
    
    pcall(function()
        if writefile then writefile(LuarmorConfig.SavedKeyFile, userKey) end
    end)
    
    if getgenv then getgenv().PayomboyZ_InputKey = userKey end
    loadstring(game:HttpGet(LuarmorConfig.StringURL))()
end

