local function launchSuite()
    local Connections = {}
    local Threads     = {}
    local Parts       = {}
    local OrigRocks   = {}
    local CWin        = nil
    local Running     = true

    local function addConn(c)
        if c and typeof(c) == "RBXScriptConnection" then
            table.insert(Connections, c)
        end
        return c
    end

    local function spawnLoop(delay, fn)
        local t = task.spawn(function()
            while Running and GENV[SCRIPT_ID] and GENV.__PYZ_TOKEN__ == myToken do
                pcall(fn)
                if not Running then break end
                local d = (type(delay) == "function" and delay()) or delay or 0.1
                task.wait(math.max(d, 0.01))
            end
        end)
        table.insert(Threads, t)
        return t
    end

    local function cleanup()
        Running = false
        for _, c in ipairs(Connections) do pcall(function() if c and c.Connected then c:Disconnect() end end) end
        table.clear(Connections)
        for _, t in ipairs(Threads) do pcall(function() if coroutine.status(t) ~= "dead" then task.cancel(t) end end) end
        table.clear(Threads)
        for _, p in ipairs(Parts) do pcall(function() if p and p.Parent then p:Destroy() end end) end
        table.clear(Parts)
        for model, props in pairs(OrigRocks) do
            pcall(function()
                if model and model.Parent then
                    if props.Pivot then model:PivotTo(props.Pivot) end
                    for child, cp in pairs(props.Descendants or {}) do
                        if child and child.Parent then
                            child.CanCollide   = cp.CanCollide
                            child.Anchored     = cp.Anchored
                            child.Transparency = cp.Transparency
                        end
                    end
                end
            end)
        end
        table.clear(OrigRocks)
        if CWin and type(CWin.Destroy) == "function" then pcall(function() CWin:Destroy() end) end
        purgeUI()
        GENV[SCRIPT_ID]     = nil
        GENV.__PYZ_TOKEN__  = nil
