local function purgeUI()
    local function sweepParent(parent)
        if not parent then return end
        pcall(function()
            for _, child in ipairs(parent:GetChildren()) do
                local n = child.Name
                if n:find("DropDown", 1, true) or n:find("Fullscreen", 1, true)
                    or n:find("ToastLayer", 1, true) or n:find("PayomboyZ", 1, true)
                    or n:find("ObsidianGlass", 1, true) or n:find("bankroll", 1, true)
                    or n:find("PYZ_KeyLoader", 1, true) then
                    pcall(function() child:Destroy() end)
                end
            end
        end)
    end
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        if lp then sweepParent(lp:FindFirstChildOfClass("PlayerGui")) end
    end)
    pcall(function()
        local cg = (typeof(cloneref) == "function" and cloneref(game:GetService("CoreGui")))
            or game:GetService("CoreGui")
        sweepParent(cg)
    end)
    pcall(function()
        if typeof(gethui) == "function" then sweepParent(gethui()) end
    end)
end

