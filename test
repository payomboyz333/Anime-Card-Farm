    -- ── FLING HELPER FUNCTION (BYPASS HEALTH - INSTANT VOID KILL) ───────────────
    local function executeFling(targetPlayer)
        local c, hrp, hum = getCharacter()
        if not c or not hrp or not hum or hum.Health <= 0 then return end
        local tChar = targetPlayer.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tRoot or not tHum or tHum.Health <= 0 then return end

        local origCF  = hrp.CFrame
        local origVel = hrp.AssemblyLinearVelocity
        local origAng = hrp.AssemblyAngularVelocity

        -- Noclip character during fling collision
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        if isPlayerOnMachine(targetPlayer) then return end
        local startT = tick()
        while tick() - startT < 0.35 do
            if not tRoot or not tRoot.Parent or tHum.Health <= 0 then break end
            hrp.CFrame = tRoot.CFrame * CFrame.new(0, 0, 0)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.new(0, 75000, 0)
            RunService.Heartbeat:Wait()
        end

        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = origCF
        task.wait(0.04)
    end

