        -- PRIORITY 4: WORKOUT & AUTO PUNCH (OPTIMIZED ENGINE)
        -- ─────────────────────────────────────────────────────────────
        local workoutTools = {}
        if S.AutoWeight     then table.insert(workoutTools, "Weight")     end
        if S.AutoPushups    then table.insert(workoutTools, "Pushups")    end
        if S.AutoHandstands then table.insert(workoutTools, "Handstands") end
        if S.AutoSitups     then table.insert(workoutTools, "Situps")     end

        local hasWorkout = #workoutTools > 0
        local hasPunch   = S.AutoPunch

        if hasWorkout and hasPunch then
            if tick() - workoutSliceTimer > 3.5 then
                workoutSliceTimer = tick()
                workoutMode = (workoutMode == "WORKOUT") and "PUNCH" or "WORKOUT"
            end
        elseif hasPunch then
            workoutMode = "PUNCH"
        elseif hasWorkout then
            workoutMode = "WORKOUT"
        else
            workoutMode = "NONE"
        end

        if workoutMode == "PUNCH" then
            FSM_STATE = "PUNCH"
            LocalPlayer:SetAttribute("AutoLiftEnabled", false)
            local punch = equipTool("Punch")
            if punch then pcall(function() punch:Activate() end) end
            if mev then
                pcall(function()
                    mev:FireServer("punch", "rightHand")
                    mev:FireServer("punch", "leftHand")
                end)
            end
        elseif workoutMode == "WORKOUT" and hasWorkout then
            FSM_STATE = "WORKOUT"
            -- Rotate active workout tool every 4 seconds if multiple tools are chosen
            if #workoutTools > 1 then
                if tick() - lastToolSwitchTime > 4.0 then
                    lastToolSwitchTime = tick()
                    currentWorkoutIdx = (currentWorkoutIdx % #workoutTools) + 1
                end
            else
                currentWorkoutIdx = 1
            end

            local toolName = workoutTools[currentWorkoutIdx] or workoutTools[1]

            -- Unequip conflicting tools only when necessary
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.Name ~= toolName then
                    local bp = LocalPlayer:FindFirstChild("Backpack")
                    if bp then t.Parent = bp end
                end
            end

            local tool = equipTool(toolName)
            if tool then
                LocalPlayer:SetAttribute("AutoLiftEnabled", true)
                pcall(function() tool:Activate() end)
                if mev then
                    pcall(function() mev:FireServer("rep") end)
                end
            end
        else
            FSM_STATE = "IDLE"
            LocalPlayer:SetAttribute("AutoLiftEnabled", false)
        end
    end

