    -- ── TOOL HELPERS ──────────────────────────────────────────────────────────
    local function applyFastTool(tool, on)
        if not tool or not tool:IsA("Tool") then return end
        pcall(function()
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local n = v.Name:lower()
                    if n:find("time", 1, true) or n:find("delay", 1, true) or n:find("cooldown", 1, true) or n:find("rep", 1, true) or n:find("attack", 1, true) then
                        v.Value = on and 0 or (n:find("attack", 1, true) and 0.35 or 1)
                    end
                end
            end
        end)
    end

    local function equipTool(name)
        local c, _, hum = getCharacter()
        if not c or not hum or hum.Health <= 0 then return nil end
        local equipped = c:FindFirstChild(name)
        if equipped and equipped:IsA("Tool") then
            if S.FastTools then applyFastTool(equipped, true) end
            return equipped
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local t = bp and bp:FindFirstChild(name)
        if t and t:IsA("Tool") then
            if S.FastTools then applyFastTool(t, true) end
            hum:EquipTool(t)
            return t
        end
        return nil
    end

    local function refreshToolSpeeds(on)
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then for _, t in ipairs(bp:GetChildren()) do applyFastTool(t, on) end end
        local c = LocalPlayer.Character
        if c then for _, t in ipairs(c:GetChildren()) do applyFastTool(t, on) end end
    end

    -- ── ROCK FINDER ───────────────────────────────────────────────────────────
    local function findRockModel(name)
        local mf = Workspace:FindFirstChild("machinesFolder")
        if mf then
            local _, hrp = getCharacter()
            local myDur = getDurability()
            local bestModel, bestDist = nil, math.huge
            for _, m in ipairs(mf:GetChildren()) do
                if m.Name == name then
                    local nd = m:FindFirstChild("neededDurability")
                    local req = (nd and nd.Value) or 0
                    if req <= myDur then
                        local ref = m:FindFirstChild("Rock") or m:FindFirstChildWhichIsA("BasePart")
                        if ref then
                            local d = hrp and (ref.Position - hrp.Position).Magnitude or 0
                            if d < bestDist then bestModel, bestDist = m, d end
                        else
                            bestModel = m; break
                        end
                    end
                end
            end
            if bestModel then return bestModel end
            for _, m in ipairs(mf:GetChildren()) do
                local nd = m:FindFirstChild("neededDurability")
                local req = (nd and nd.Value) or 0
                if req <= myDur and m.Name:lower():find(name:lower(), 1, true) then
                    return m
                end
            end
        end
        return nil
    end

