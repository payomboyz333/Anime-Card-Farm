local function loadCachedKey()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
    if not isfile(KEY_CACHE_FILE) then return nil end
    local ok, content = pcall(readfile, KEY_CACHE_FILE)
    if not ok or type(content) ~= "string" or #content < 5 then return nil end
    local decOk, data = pcall(function() return HttpService:JSONDecode(content) end)
    if decOk and type(data) == "table" and data.key == VALID_KEY and type(data.expires_at) == "number" then
        if os.time() < data.expires_at then
            return data
        end
    end
    return nil
end

local function saveCachedKey()
    if type(writefile) ~= "function" then return end
    local data = {
        key          = VALID_KEY,
        activated_at = os.time(),
        expires_at   = os.time() + KEY_DURATION_SECONDS,
    }
    pcall(function()
        writefile(KEY_CACHE_FILE, HttpService:JSONEncode(data))
    end)
end

