    -- ── COMBAT & SAFE ZONE DETECTOR ───────────────────────────────────────────
    local function inSafeZone(targetChar)
        if not targetChar then return true end
        if targetChar:FindFirstChild("spawnProtectionHighlight") then return true end
        if targetChar:FindFirstChildOfClass("ForceField") then return true end
        local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then return true end
        local pos = tRoot.Position

        -- 1. Main Spawn Gym (0, 0, 0)
        if (pos - Vector3.new(0, 0, 0)).Magnitude < 140 then return true end

        -- 2. Area Circles in Workspace
        local ac = Workspace:FindFirstChild("areaCircles")
        if ac then
            for _, circle in ipairs(ac:GetChildren()) do
                local part = circle:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local radius = math.max((part.Size.Y + part.Size.Z) / 2 + 10, 30)
                    if (pos - part.Position).Magnitude < radius then
                        return true
                    end
                end
            end
        end

        return false
    end

    local function isPlayerOnMachine(p)
        if not p then return false end
        local mInUse = p:FindFirstChild("machineInUse")
        if mInUse and mInUse.Value ~= nil then return true end
        local tInUse = p:FindFirstChild("treadmillInUse")
        if tInUse and tInUse.Value ~= nil then return true end
        return false
    end

    local function getPlayerList()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and not (S.IgnoreFriends and isFriend(p)) then
                local char = p.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hp = (hum and hum.Health > 0 and hum.Health) or 0
                local safe = char and inSafeZone(char)
                local onMachine = isPlayerOnMachine(p)

                local statusTag = ""
                if onMachine then
                    statusTag = " 🏋️[BUSY]"
                elseif safe then
                    statusTag = " 🛡️[SAFE]"
                else
                    statusTag = " ⚔️[TARGET]"
                end

                table.insert(list, {
                    Player = p,
                    Name = p.Name,
                    HP = hp,
                    InSafe = safe,
                    OnMachine = onMachine,
                    Label = string.format("%s [HP: %s]%s", p.Name, fmtNum(hp), statusTag)
                })
            end
        end
        if S.PrioritizeLowestHP then
            table.sort(list, function(a, b)
                if a.OnMachine ~= b.OnMachine then return not a.OnMachine end
                if a.InSafe ~= b.InSafe then return not a.InSafe end
                return a.HP < b.HP
            end)
        else
            table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
        end
        return list
    end

    -- ==============================================================================
    -- CENTRALIZED STATE COORDINATOR (UNIFIED FSM)
    -- ==============================================================================
    local FSM_STATE           = "IDLE"
    local combatOriginalCF    = nil
    local combatTargetUid     = nil
    local combatStuckTime     = 0
    local combatLastHp        = 0
    local killBlacklist       = {}
    local workoutSliceTimer   = 0
    local workoutMode         = "WORKOUT"
    local currentWorkoutIdx   = 1
    local lastToolSwitchTime  = 0

    local function runCoordinatorTick()
        local c, hrp, hum = getCharacter()
        if not c or not hrp or not hum or hum.Health <= 0 then return end

        local mev = getMuscleEvent()

        -- ─────────────────────────────────────────────────────────────
        -- PRIORITY 1: AUTO WIN BRAWL
        -- ─────────────────────────────────────────────────────────────
        local brawlState = ReplicatedStorage:FindFirstChild("shared")
            and ReplicatedStorage.shared:FindFirstChild("state")
            and ReplicatedStorage.shared.state:FindFirstChild("Brawl")
        local brawlInProgress = (brawlState and brawlState:GetAttribute("BrawlInProgress"))
            or (ReplicatedStorage:FindFirstChild("brawlInProgress") and ReplicatedStorage.brawlInProgress.Value)

        if S.AutoWinBrawl and brawlInProgress then
            FSM_STATE = "BRAWL"
            local punch = equipTool("Punch")
            if punch then pcall(function() punch:Activate() end) end
            if mev then
                pcall(function()
                    mev:FireServer("punch", "rightHand")
                    mev:FireServer("punch", "leftHand")
                end)
            end
            local myHand = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    local tHum  = p.Character:FindFirstChildOfClass("Humanoid")
                    if tRoot and tHum and tHum.Health > 0 and myHand and type(firetouchinterest) == "function" then
                        firetouchinterest(tRoot, myHand, 0); task.wait(0.005); firetouchinterest(tRoot, myHand, 1)
                    end
                end
            end
            return
        end

        -- ─────────────────────────────────────────────────────────────
        -- PRIORITY 2: STEALTH AUTO KILL (COMBAT)
        -- ─────────────────────────────────────────────────────────────
        if S.AutoKillAll or S.AutoKillSelected then
            local targetChar, targetPlayer = nil, nil

            if S.AutoKillSelected and S.SelectedKillPlayer ~= "" and S.SelectedKillPlayer ~= "No Target Available" then
                local p = Players:FindFirstChild(S.SelectedKillPlayer)
                if p and p.Character then
                    local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                    local isSafe = inSafeZone(p.Character)
                    local onMachine = isPlayerOnMachine(p)
                    if tHum and tHum.Health > 0 and (not S.SkipSafeZone or (not isSafe and not onMachine)) then
                        targetChar = p.Character
                        targetPlayer = p
                    end
                end
            elseif S.AutoKillAll then
                local candidates = getPlayerList()
                for _, item in ipairs(candidates) do
                    local p = item.Player
                    if p and p.Character then
                        local uid = p.UserId
                        local bl = killBlacklist[uid]
                        if not (bl and tick() < bl) then
                            local isSafe = inSafeZone(p.Character)
                            local onMachine = isPlayerOnMachine(p)
                            if not S.SkipSafeZone or (not isSafe and not onMachine) then
                                if S.MaxTargetHP == 0 or item.HP <= S.MaxTargetHP then
                                    targetChar = p.Character
                                    targetPlayer = p
                                    break
                                end
                            end
                        end
                    end
                end
            end

            if targetChar and targetPlayer then
                if not combatOriginalCF then
                    combatOriginalCF = hrp.CFrame
                end
                FSM_STATE = "COMBAT"

                local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
                local tHum = targetChar:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and tHum.Health > 0 then
                    local uid = targetPlayer.UserId
                    if combatTargetUid ~= uid then
                        combatTargetUid = uid
                        combatStuckTime = tick()
                        combatLastHp    = tHum.Health
                    else
                        if tHum.Health < combatLastHp then
                            combatLastHp    = tHum.Health
                            combatStuckTime = tick()
                        elseif tick() - combatStuckTime > 10.0 then
                            killBlacklist[uid] = tick() + 15
                            combatTargetUid    = nil
                            combatStuckTime    = 0
                            return
                        end
                    end

                    local pos = tRoot.Position
                    local style = S.KillStyle
                    if style == "Silent Behind" then
                        local behindVec = tRoot.CFrame.LookVector * -2.2
                        hrp.CFrame = CFrame.lookAt(pos + behindVec + Vector3.new(0, 0.3, 0), pos)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    elseif style == "Sky Stomp" then
                        hrp.CFrame = CFrame.lookAt(pos + Vector3.new(0, 4.2, 0), pos)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    elseif style == "Underground Shadow" then
                        hrp.CFrame = CFrame.lookAt(pos + Vector3.new(0, -3.5, 0), pos)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    elseif style == "Orbit Whirlwind" then
                        local ang = (tick() * 6) % (math.pi * 2)
                        hrp.CFrame = CFrame.lookAt(pos + Vector3.new(math.cos(ang)*2.8, 0.4, math.sin(ang)*2.8), pos)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    elseif style == "Fling Void (Instant KO)" then
                        hrp.CFrame = CFrame.lookAt(pos, pos + tRoot.CFrame.LookVector)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 75000, 0)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    else
                        hrp.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.2)
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end

                    -- Equip Punch
                    local punch = equipTool("Punch")
                    if punch then pcall(function() punch:Activate() end) end
                    if mev then
                        for _ = 1, 6 do
                            mev:FireServer("punch", "rightHand")
                            mev:FireServer("punch", "leftHand")
                        end
                    end
                    return
                end
            else
                combatTargetUid = nil
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.AssemblyLinearVelocity = Vector3.zero
                if S.ReturnOriginalSpot and combatOriginalCF then
                    hrp.CFrame = combatOriginalCF
                    hrp.Velocity = Vector3.zero
                end
            end
        else
            combatOriginalCF = nil
            combatTargetUid  = nil
        end

        -- ─────────────────────────────────────────────────────────────
        -- ─────────────────────────────────────────────────────────────
        -- PRIORITY 3: ROCK FARM ENGINE
        -- ─────────────────────────────────────────────────────────────
        if S.RockGlitchActive or S.RockTeleportActive then
            local rName = S.SelectedRock
            if rName == "Auto (หินระดับสูงสุดที่ทำได้)" or not ROCK_DATA[rName] then
                rName = getBestRockForPlayer()
            end
            local rInfo = ROCK_DATA[rName]
            if rInfo and getDurability() >= rInfo.Dur then
                FSM_STATE = "ROCK_FARM"
                local model = findRockModel(rName)
                local rockPart = nil
                if model then
                    for _, v in ipairs(model:GetDescendants()) do
                        if v:IsA("BasePart") and (v.Name == "Rock" or v.Name == "Part" or v.Name == "Hitbox") then
                            rockPart = v; break
                        end
                    end
                    rockPart = rockPart or model:FindFirstChildWhichIsA("BasePart")
                end

                local punch = equipTool("Punch")
                if punch then pcall(function() punch:Activate() end) end
                if mev then
                    pcall(function()
                        mev:FireServer("punch", "rightHand")
                        mev:FireServer("punch", "leftHand")
                    end)
                end

                local myR = c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")

                if S.RockGlitchActive and model and rockPart then
                    if not OrigRocks[model] then
                        local dp = {}
                        for _, child in ipairs(model:GetDescendants()) do
                            if child:IsA("BasePart") then
                                dp[child] = { CanCollide=child.CanCollide, Anchored=child.Anchored, Transparency=child.Transparency }
                            end
                        end
                        OrigRocks[model] = { Pivot = model:GetPivot(), Descendants = dp }
                    end
                    for child in pairs(OrigRocks[model].Descendants) do
                        child.CanCollide   = false
                        child.Anchored     = true
                        child.Transparency = 0.35
                    end
                    model:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2.2))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    if type(firetouchinterest) == "function" and myR then
                        firetouchinterest(rockPart, myR, 0); task.wait(0.005); firetouchinterest(rockPart, myR, 1)
                    end
                elseif S.RockTeleportActive and rockPart then
                    hrp.CFrame = rockPart.CFrame * CFrame.new(0, 0, 2.5)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    if type(firetouchinterest) == "function" and myR then
                        firetouchinterest(rockPart, myR, 0); task.wait(0.005); firetouchinterest(rockPart, myR, 1) end
                elseif rInfo then
                    hrp.CFrame = rInfo.CF
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                return
            end
        end

