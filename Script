local function GetInventoryCardsForReroll()
	local player = game:GetService("Players").LocalPlayer
	local inventoryMap = {}
	local list = {}
	local nameCounts = {}

	local function scanFolder(folder)
		if not folder then return end
		for _, item in ipairs(folder:GetChildren()) do
			if item:IsA("Tool") and not isPackCard(item) then
				local cardName = item:GetAttribute("CardName") or item:GetAttribute("TemplateName") or item.Name
				local mutation = getCardMutation(item)
				local trait = getCardTrait(item)
				local rank = getCardRank(item)
				
				local baseDisplay = string.format("[%s] %s | Rnk: %s | Trt: %s", mutation, cardName, rank, trait)
				nameCounts[baseDisplay] = (nameCounts[baseDisplay] or 0) + 1
				
				local uniqueKey = baseDisplay
				if nameCounts[baseDisplay] > 1 then
					uniqueKey = baseDisplay .. string.format(" (#%d)", nameCounts[baseDisplay])
				end
				
				inventoryMap[uniqueKey] = item
				table.insert(list, uniqueKey)
			end
		end
	end

	pcall(function()
		scanFolder(player:FindFirstChild("Backpack"))
		if player.Character then scanFolder(player.Character) end
	end)
	
	getgenv().RerollInventoryMap = inventoryMap
	if #list == 0 then table.insert(list, "No cards found") end
	return list
end

