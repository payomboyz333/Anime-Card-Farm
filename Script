local function updateHorstDescription()
    local localPlayer = Players.LocalPlayer
    if not localPlayer then return end

    local coins = "0"
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local hud = playerGui:FindFirstChild("HUD")
        local currencies = hud and hud:FindFirstChild("Currencies")
        local coinsCounter = currencies and currencies:FindFirstChild("CoinsCounter")
        local coinsLabel = coinsCounter and coinsCounter:FindFirstChild("TextLabel")

        if coinsLabel and coinsLabel.Text then
            coins = coinsLabel.Text
        end
    end

    local cvStr = "Cv:0"
    if playerGui then
        local hud = playerGui:FindFirstChild("HUD")
        local conveyor = hud and (hud:FindFirstChild("Conveyor") or hud:FindFirstChild("ConveyorLevel"))
        local levelLabel = conveyor and (conveyor:FindFirstChild("Level") or conveyor:FindFirstChild("TextLabel"))
        
        if levelLabel then
            local levelText = tostring(levelLabel.Text):match("%d+") or levelLabel.Text
            cvStr = "Cv:" .. tostring(levelText)
        else
            local conveyorVal = localPlayer:FindFirstChild("ConveyorLevel") or localPlayer:FindFirstChild("Conveyor")
            if conveyorVal then
                cvStr = "Cv:" .. tostring(conveyorVal.Value)
            end
        end
    end

    local cardStats = {
        Grail   = {Rad = 0, Gli = 0, Star = 0, Adm = 0, Unk = 0},
        Academy = {Rad = 0, Gli = 0, Star = 0, Adm = 0, Unk = 0}
    }

    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local itemName = item.Name:lower()
                local itemMutation = tostring(item:GetAttribute("Mutation") or ""):lower()
                local fullText = itemName .. " " .. itemMutation

                for rarity, data in pairs(cardStats) do
                    if itemName:find(rarity:lower()) then
                        if fullText:find("radioactive") then
                            data.Rad = data.Rad + 1
                        elseif fullText:find("glitch") then
                            data.Gli = data.Gli + 1
                        elseif fullText:find("starfallen") then
                            data.Star = data.Star + 1
                        elseif fullText:find("admin") then
                            data.Adm = data.Adm + 1
                        elseif fullText:find("unknow") or fullText:find("unknown") then
                            data.Unk = data.Unk + 1
                        end
                        break
                    end
                end
            end
        end
    end

    local message = string.format(
        "💰 %s ⚙️ %s - 🏆 Grail: [Rad:%d Gli:%d Star:%d Adm:%d Unk:%d] 📮 Academy: [Rad:%d Gli:%d Star:%d Adm:%d Unk:%d]",
        coins, cvStr,
        cardStats.Grail.Rad,   cardStats.Grail.Gli,   cardStats.Grail.Star,   cardStats.Grail.Adm,   cardStats.Grail.Unk,
        cardStats.Academy.Rad, cardStats.Academy.Gli, cardStats.Academy.Star, cardStats.Academy.Adm, cardStats.Academy.Unk
    )

    local item_data = {
        Coins = coins,
        ConveyorLevel = cvStr,
        Grail = cardStats.Grail,
        Academy = cardStats.Academy
    }
    local EncodeJson = HttpService:JSONEncode(item_data)

    if _G and type(_G.Horst_SetDescription) == "function" then
        pcall(function()
            _G.Horst_SetDescription(message, EncodeJson)
        end)
    end
end

task.spawn(function()
    while true do
        updateHorstDescription()
        task.wait(2)
    end
end)

