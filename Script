getgenv().CardESP = false

local function applyESP(model)
    if not model:IsA("Model") or model:FindFirstChild("CardESP_Tag") then return end
    
    local rarityLabel = model:FindFirstChild("Rarity", true)
    local mutationLabel = model:FindFirstChild("Mutation", true)
    local cardRarity = rarityLabel and string.gsub(rarityLabel.Text, "<[^>]+>", "") or "Card"
    local cardMutation = mutationLabel and string.gsub(mutationLabel.Text, "<[^>]+>", "") or ""
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "CardESP_Tag"
    highlight.Adornee = model
    highlight.FillColor = Color3.fromRGB(255, 50, 50)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.Parent = model
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CardESP_Text"
    billboard.Adornee = model
    billboard.Size = UDim2.new(0, 150, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = cardRarity .. (cardMutation ~= "" and ("\n[" .. cardMutation .. "]") or "")
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextStrokeTransparency = 0
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard
    billboard.Parent = model
end

local function removeESP(model)
    if model:FindFirstChild("CardESP_Tag") then model.CardESP_Tag:Destroy() end
    if model:FindFirstChild("CardESP_Text") then model.CardESP_Text:Destroy() end
end

MainTab:Toggle({
    Title = "Card Pack ESP (มองซองทะลุ)",
    Value = getgenv().CardESP,
