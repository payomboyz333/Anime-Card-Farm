        local cl = Instance.new("TextLabel"); cl.Size = UDim2.new(0,40,0,18); cl.Position = UDim2.new(1,-46,0.5,-9); cl.BackgroundColor3 = Colors.Accent; cl.BackgroundTransparency = 0.6; cl.Text = "x"..card.Count; cl.TextSize = 10; cl.Font = Enum.Font.GothamBold; cl.TextColor3 = Colors.AccentGlow; cl.Parent = btn; addCorner(cl, 4)

        btn.MouseEnter:Connect(function() tween(btn, {BackgroundTransparency = 0}, 0.15); tween(cs, {Color = Colors.Cyan, Transparency = 0.3}, 0.15) end)
        btn.MouseLeave:Connect(function() if SelectedCard ~= card.Name then tween(btn, {BackgroundTransparency = 0.3}, 0.15); tween(cs, {Color = Colors.Border, Transparency = 0.7}, 0.15) end end)
        btn.MouseButton1Click:Connect(function()
            SelectedCard = card.Name; SendAmount = 1; AmountDisplay.Text = "1"
            SelectedCardLabel.Text = "🃏 "..card.Name.." (x"..card.Count..")"
            SelectedCardLabel.TextColor3 = Colors.Cyan
            for _, c in ipairs(CardListFrame:GetChildren()) do if c:IsA("TextButton") and c ~= btn then tween(c, {BackgroundTransparency = 0.3}, 0.15) end end
            tween(btn, {BackgroundTransparency = 0}, 0.15); tween(cs, {Color = Colors.Cyan, Transparency = 0}, 0.15)
            addLog("🃏 เลือก: "..card.Name.." (x"..card.Count..")", Colors.Cyan)
        end)
    end
    if #cards > 0 and not SelectedCard then SelectedCard = cards[1].Name; SelectedCardLabel.Text = "🃏 Auto: "..cards[1].Name.." (x"..cards[1].Count..")"; SelectedCardLabel.TextColor3 = Colors.Cyan end
end
