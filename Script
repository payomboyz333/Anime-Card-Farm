				end
				local combinedText = pText .. " " .. oText
				
				local isIgnoredPrompt = string.find(combinedText, "BUY") or string.find(combinedText, "ซื้อ")
					or string.find(combinedText, "SPAWN") or string.find(combinedText, "สุ่ม")
					or string.find(combinedText, "OPEN") or string.find(combinedText, "เปิด")
					or string.find(combinedText, "TOWER") or string.find(combinedText, "ทาวเวอร์")
					or string.find(combinedText, "UPGRADE") or string.find(combinedText, "อัปเกรด")
					or string.find(combinedText, "CLAIM") or string.find(combinedText, "รับ")
					or string.find(combinedText, "SELL") or string.find(combinedText, "ขาย")
					or string.find(combinedText, "REBIRTH") or string.find(combinedText, "จุติ")
					or string.find(combinedText, "JOIN") or string.find(combinedText, "ENTER")
				
				if not isIgnoredPrompt then
					local model = desc:FindFirstAncestorOfClass("Model")
					if model and model.Name ~= "SellPart" and not model:FindFirstChildOfClass("Humanoid") then
						-- Check if this is a Pack Card (skip it!)
						local isPack = isPackCard(model)
						if not isPack then
							for _, txtObj in ipairs(model:GetDescendants()) do
								if (txtObj:IsA("TextLabel") or txtObj:IsA("TextButton")) then
									local txtUpper = string.upper(txtObj.Text or "")
									if string.find(txtUpper, "PACK") or string.find(txtUpper, "แพ็ค") or string.find(txtUpper, "แพ็ก") or string.find(txtUpper, "BOX") or string.find(txtUpper, "กล่อง") then
										isPack = true
										break
									end
								end
							end
						end
						
						if isPack then continue end
						
						-- Score: prioritize cash value first, then mutation/rarity
						local cashScore = 0
						local rarityScore = 0
						local mutationScore = 0
						
						for _, txtObj in ipairs(model:GetDescendants()) do
							if txtObj:IsA("TextLabel") or txtObj:IsA("TextButton") then
								local val = parseSuffixValue(txtObj.Text)
								if val > cashScore then cashScore = val end
								
								local s = getRarityScore(txtObj.Text)
								if s > rarityScore then rarityScore = s end
								
								-- Check mutation text
								local cleanMut = string.lower(string.gsub(txtObj.Text or "", "<[^>]+>", ""))
								cleanMut = string.match(cleanMut, "^%s*(.-)%s*$") or ""
								local MutationScores = {
									["unknow"] = 130, ["admin"] = 120,
									["starfallen"] = 110, ["glitch"] = 100,
									["radioactive"] = 90, ["blessed"] = 80,
									["candy"] = 70, ["sakura"] = 60,
									["rainbow"] = 50, ["venomous"] = 40,
									["diamond"] = 30, ["golden"] = 20,
								}
								for mName, mScore in pairs(MutationScores) do
									if string.find(cleanMut, mName) then
										if mScore > mutationScore then mutationScore = mScore end
									end
								end
							end
						end
						
						if cashScore == 0 and rarityScore == 0 then
							local lvl = model:GetAttribute("Level") or model:GetAttribute("CardLevel") or 0
							if tonumber(lvl) then cashScore = tonumber(lvl) end
							if cashScore == 0 then
								local val = model:GetAttribute("CashMultiplier") or model:GetAttribute("Multiplier")
								if tonumber(val) then cashScore = tonumber(val) end
							end
						end

						local isPickupPrompt = (desc:IsA("ProximityPrompt") and (
							pText == "E" or pText == "" or string.find(combinedText, "PICK") or string.find(combinedText, "TAKE")
							or string.find(combinedText, "COLLECT") or string.find(combinedText, "EQUIP")
							or string.find(combinedText, "HOLD") or string.find(combinedText, "GRAB")
							or string.find(combinedText, "หยิบ") or string.find(combinedText, "เก็บ")
							or string.find(combinedText, "CARD") or string.find(combinedText, "การ์ด")
						)) or desc:IsA("ClickDetector")

						local totalScore = cashScore + (rarityScore * 1000) + (mutationScore * 100)
						if (totalScore > 0 or isPickupPrompt) and not string.find(modelNameUpper, "PLOT") then
							table.insert(cardList, { interact = desc, score = totalScore, model = model })
						end
					end
				end
			end
		end

		if #cardList == 0 then return end
		table.sort(cardList, function(a, b) return a.score > b.score end)

		local originalCFrame = hrp.CFrame
		getgenv().CollectedCardPositions = {}

		for i = 1, math.min(4, #cardList) do
			local item = cardList[i]
			if item and item.interact and item.interact.Parent then
				pcall(function()
					local targetPos
					if item.interact.Parent:IsA("BasePart") then
						targetPos = item.interact.Parent.Position
					elseif item.interact.Parent:IsA("Attachment") then
						targetPos = item.interact.Parent.WorldPosition
					elseif item.model and item.model.PrimaryPart then
						targetPos = item.model.PrimaryPart.Position
					else
						local part = item.model and item.model:FindFirstChildWhichIsA("BasePart")
						if part then targetPos = part.Position end
					end
					
					if targetPos and hrp then
						table.insert(getgenv().CollectedCardPositions, targetPos)
						hrp.CFrame = CFrame.new(targetPos) + Vector3.new(0, 2, 0)
						task.wait(0.8)
						
						if item.interact:IsA("ProximityPrompt") then
							item.interact.RequiresLineOfSight = false
							item.interact.MaxActivationDistance = 99999
							item.interact.HoldDuration = 0
							for count = 1, 5 do
								if not item.interact or not item.interact.Parent then break end
								if fireproximityprompt then
									fireproximityprompt(item.interact)
								end
								task.wait(0.3)
							end
						elseif item.interact:IsA("ClickDetector") then
							for count = 1, 5 do
								if fireclickdetector then
									fireclickdetector(item.interact)
								end
								task.wait(0.3)
							end
						end
						task.wait(1.0)
					end
				end)
			end
		end

		if originalCFrame and hrp then
			hrp.CFrame = originalCFrame
			task.wait(0.5)
		end
	end)
end

local function placeCollectedCardsBack()
	pcall(function()
		local positions = getgenv().CollectedCardPositions
		if not positions or #positions == 0 then return end

		local player = game:GetService("Players").LocalPlayer

		for i, pos in ipairs(positions) do
			pcall(function()
				-- Re-fetch character each iteration (may have respawned)
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if not hrp or not humanoid then return end

				-- 1. Get first card tool from Backpack (excluding Pack Cards)
				local backpack = player:FindFirstChild("Backpack")
				local tool
				if backpack then
					for _, t in ipairs(backpack:GetChildren()) do
						if t:IsA("Tool") and not isPackCard(t) then
							tool = t
							break
						end
					end
				end

				-- 2. Equip tool properly using Humanoid:EquipTool
				if tool then
					humanoid:EquipTool(tool)
					task.wait(1.0)
				else
					return -- No tool to place, skip
				end

				-- 3. Teleport to pedestal position
				hrp.CFrame = CFrame.new(pos) + Vector3.new(0, 2, 0)
				task.wait(0.8)

				-- 4. Find ProximityPrompt/ClickDetector on or near pedestal to place card back
				local plotNum = player:FindFirstChild("PlotNumber") and player.PlotNumber.Value or 0
				local plotFolder
				if plotNum ~= 0 then
					plotFolder = workspace:FindFirstChild("MAP")
						and workspace.MAP:FindFirstChild("Plots")
						and workspace.MAP.Plots:FindFirstChild(tostring(plotNum))
				end

				if plotFolder then
					for _, desc in ipairs(plotFolder:GetDescendants()) do
						if desc:IsA("ProximityPrompt") or desc:IsA("ClickDetector") then
							local descPos
							if desc.Parent:IsA("BasePart") then descPos = desc.Parent.Position
							elseif desc.Parent:IsA("Attachment") then descPos = desc.Parent.WorldPosition end
							
							if descPos and (descPos - pos).Magnitude < 5 then
								if desc:IsA("ProximityPrompt") then
									desc.RequiresLineOfSight = false
									desc.MaxActivationDistance = 99999
									desc.HoldDuration = 0
									for _ = 1, 5 do
										if fireproximityprompt then fireproximityprompt(desc) end
										task.wait(0.3)
									end
								elseif desc:IsA("ClickDetector") then
									for _ = 1, 4 do
										if fireclickdetector then fireclickdetector(desc) end
										task.wait(0.3)
									end
								end
								break
							end
						end
					end
				end
				task.wait(1.7)
			end)
		end

		getgenv().CollectedCardPositions = nil
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			-- Return to original position (base)
			task.wait(0.5)
		end
	end)
end

local function reequipBaseCards()
	placeCollectedCardsBack()
end

