-- ปุ่มส่งด้วยตนเอง (Manual Send)
SendBtn.MouseButton1Click:Connect(function()
    if AutoTrading then addLog("⚠️ ระบบ Auto Trade กำลังทำงาน!", Colors.Orange); return end
    if not SelectedPlayer then addLog("❌ กรุณาเลือกผู้เล่น!", Colors.Red); return end
    if not SelectedCard then addLog("❌ กรุณาเลือกการ์ด!", Colors.Red); return end

    SendBtnLabel.Text = "⏳  กำลังดำเนินการ..."

    task.spawn(function()
        local sent = 0
        for i = 1, SendAmount do
            TSL.Text = "📤 กำลังส่ง " .. i .. "/" .. SendAmount
            local ok = doSendGift(SelectedPlayer, SelectedCard)
            if ok then
                sent = sent + 1
            else
                addLog("⚠️ หยุดส่งชั่วคราวที่ " .. i .. "/" .. SendAmount, Colors.Orange)
                break
            end
            if i < SendAmount then task.wait(0.2) end
        end
        SendBtnLabel.Text = "✅ ส่งแล้ว " .. sent .. "/" .. SendAmount .. " ใบ!"
        addLog("📊 สรุป: ส่งไปแล้ว " .. sent .. "/" .. SendAmount .. " ใบ", Colors.Green)
        task.wait(1.2)
        updateSendBtnText()
        refreshCardList()
    end)
end)

