local function getPlayerCards()
    local cards = {}; local cc = {}
    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do if t:IsA("Tool") then cc[t.Name] = (cc[t.Name] or 0) + 1 end end
    if LocalPlayer.Character then for _, t in ipairs(LocalPlayer.Character:GetChildren()) do if t:IsA("Tool") then cc[t.Name] = (cc[t.Name] or 0) + 1 end end end
    for n, c in pairs(cc) do table.insert(cards, {Name = n, Count = c}) end
    table.sort(cards, function(a, b) return a.Count > b.Count end)
    return cards
end

local function refreshCardList()
    for _, c in ipairs(CardListFrame:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local cards = getPlayerCards()
    if #cards == 0 then local e = Instance.new("TextLabel"); e.Size = UDim2.new(1,0,0,24); e.BackgroundTransparency = 1; e.Text = "❌ ไม่มีการ์ด"; e.TextSize = 11; e.Font = Enum.Font.GothamMedium; e.TextColor3 = Colors.TextMuted; e.Parent = CardListFrame; return end

    for i, card in ipairs(cards) do
        local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1,0,0,28); btn.BackgroundColor3 = Colors.BGLight; btn.BackgroundTransparency = 0.3; btn.BorderSizePixel = 0; btn.Text = ""; btn.AutoButtonColor = false; btn.LayoutOrder = i; btn.Parent = CardListFrame; addCorner(btn, 5)
