local function isPackCard(obj)
	if not obj then return false end
	if obj:GetAttribute("BoxValue") ~= nil or obj:GetAttribute("IsPack") == true then
		return true
	end
	local name = string.lower(obj.Name or "")
	local template = string.lower(tostring(obj:GetAttribute("TemplateName") or ""))
	local cardName = string.lower(tostring(obj:GetAttribute("CardName") or ""))
	
	if string.find(name, "pack") or string.find(name, "แพ็ค") or string.find(name, "แพ็ก") or string.find(name, "box") or string.find(name, "กล่อง") then
		return true
	end
	if string.find(template, "pack") or string.find(template, "แพ็ค") or string.find(template, "แพ็ก") or string.find(template, "box") or string.find(template, "กล่อง") then
		return true
	end
	if string.find(cardName, "pack") or string.find(cardName, "แพ็ค") or string.find(cardName, "แพ็ก") or string.find(cardName, "box") or string.find(cardName, "กล่อง") then
		return true
	end
	return false
end

