getgenv().CardESP = true
getgenv().ESPBillboards = getgenv().ESPBillboards or {}

local function clearCardESP()
	for _, bb in ipairs(getgenv().ESPBillboards) do
		pcall(function() bb:Destroy() end)
	end
	getgenv().ESPBillboards = {}

	-- Clear any leftover 3D BillboardGuis from screen
	pcall(function()
		local coreGui = game:GetService("CoreGui")
		for _, child in ipairs(coreGui:GetChildren()) do
			if child:IsA("BillboardGui") and string.find(child.Name, "CardESP_") then
				child:Destroy()
			end
		end
	end)
end

local function updateCardESP()
	clearCardESP()
	local player = game:GetService("Players").LocalPlayer
	if not player then return end

	-- 1. Scan Backpack (Rename Tools to show mutation in hotbar UI)
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				local mutVal = tool:GetAttribute("Mutation")
				if not mutVal then
					local mutLabel = tool:FindFirstChild("Mutation", true)
					if mutLabel and mutLabel:IsA("TextLabel") then mutVal = mutLabel.Text
					elseif mutLabel and mutLabel:IsA("StringValue") then mutVal = mutLabel.Value end
				end
				if mutVal then
					local clean = string.gsub(mutVal, "<[^>]+>", "")
					clean = string.match(clean, "^%s*(.-)%s*$") or ""
					if clean ~= "" and clean ~= "Label" and clean ~= "Normal" then
						if not string.find(tool.Name, "%[" .. clean .. "%]") then
							tool.Name = "[" .. clean .. "] " .. tool.Name
						end
					end
				end
			end
		end
	end

	-- 2. Scan PlayerGui (Overlay Mutation status inside Inventory GUI slots)
	local playerGui = player:FindFirstChild("PlayerGui")
	if playerGui then
		local espGui2D = game:GetService("CoreGui"):FindFirstChild("PayomboyZ_InvESP")
		if not espGui2D then
			espGui2D = Instance.new("ScreenGui")
			espGui2D.Name = "PayomboyZ_InvESP"
			espGui2D.Parent = game:GetService("CoreGui")
		end
		espGui2D:ClearAllChildren()
		table.insert(getgenv().ESPBillboards, espGui2D)

		for _, vp in ipairs(playerGui:GetDescendants()) do
			if vp:IsA("ViewportFrame") and vp.Visible then
				local model = vp:FindFirstChildWhichIsA("Model")
				if model then
					local mutationLabel = model:FindFirstChild("Mutation", true)
					if mutationLabel and mutationLabel:IsA("TextLabel") then
						local clean = string.gsub(mutationLabel.Text or "", "<[^>]+>", "")
						clean = string.match(clean, "^%s*(.-)%s*$") or ""
						if clean ~= "" and clean ~= "Label" and clean ~= "Normal" then
							local textLabel = Instance.new("TextLabel")
							textLabel.Size = UDim2.new(1, 0, 0, 20)
							textLabel.Position = UDim2.new(0, 0, 1, -20)
							textLabel.BackgroundTransparency = 0.3
							textLabel.BackgroundColor3 = Color3.new(0, 0, 0)
							
							local mutColor = Color3.fromRGB(255, 255, 255)
							local mutLower = string.lower(clean)
							if mutLower == "golden" then mutColor = Color3.fromRGB(255, 200, 50)
							elseif mutLower == "diamond" then mutColor = Color3.fromRGB(100, 180, 255)
							elseif mutLower == "venomous" then mutColor = Color3.fromRGB(150, 100, 255)
							elseif mutLower == "rainbow" then mutColor = Color3.fromRGB(255, 100, 255)
							elseif mutLower == "sakura" then mutColor = Color3.fromRGB(255, 130, 160)
							elseif mutLower == "candy" then mutColor = Color3.fromRGB(255, 255, 100)
							elseif mutLower == "blessed" then mutColor = Color3.fromRGB(255, 220, 80)
							elseif mutLower == "radioactive" then mutColor = Color3.fromRGB(80, 255, 80)
							elseif mutLower == "glitch" then mutColor = Color3.fromRGB(180, 130, 255)
							elseif mutLower == "starfallen" then mutColor = Color3.fromRGB(255, 80, 220)
							elseif mutLower == "admin" then mutColor = Color3.fromRGB(255, 50, 50)
							elseif mutLower == "unknow" then mutColor = Color3.fromRGB(30, 30, 30) end
							
							textLabel.TextColor3 = mutColor
							textLabel.TextScaled = true
							textLabel.Font = Enum.Font.GothamBold
							textLabel.Text = clean
							textLabel.ZIndex = 100
							
							pcall(function()
								textLabel.Parent = vp.Parent
								table.insert(getgenv().ESPBillboards, textLabel)
							end)
						end
					end
				end
			end
		end
	end
end

