-- ============================================================
-- 📡 GIFT LOGIC — EQUIP + TP + ProximityPrompt
-- ============================================================
local function findGiftPrompt(character)
    if not character then return nil end
    for _, d in ipairs(character:GetDescendants()) do if d:IsA("ProximityPrompt") then return d end end
    return nil
end

local function equipCard(cardName)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and currentTool.Name == cardName then
        return true
    end

    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == cardName then
            humanoid:EquipTool(tool)
            task.wait(0.15)
            return true
        end
    end
    return false
end

local function moveToPlayer(targetPlayer)
    local myChar = LocalPlayer.Character
    local targetChar = targetPlayer.Character
    if not myChar or not targetChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return false end

    local dir = (myRoot.Position - targetRoot.Position)
    if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 0) end
    local targetCF = CFrame.new(targetRoot.Position + dir.Unit * 3, targetRoot.Position)

    if UseTween then
        local dist = (myRoot.Position - targetCF.Position).Magnitude
        local dur = math.clamp(dist / 120, 0.15, 4)
        TSL.Text = "🚀 Tween... " .. math.floor(dist) .. " studs"
        local tw = TweenService:Create(myRoot, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCF})
        tw:Play(); tw.Completed:Wait()
    else
        TSL.Text = "⚡ TP!"
        myRoot.CFrame = targetCF
    end
    task.wait(0.15)
    return true
end

local function doSendGift(targetPlayer, cardName)
    if not targetPlayer or not targetPlayer.Character then
        addLog("❌ ไม่มี Character Target!", Colors.Red); return false
    end

    TSL.Text = "🃏 Equip " .. cardName .. "..."
    local equipped = equipCard(cardName)
    if not equipped then
        addLog("❌ ไม่มี " .. cardName .. " เหลือแล้ว!", Colors.Red)
        return false
    end

    if not moveToPlayer(targetPlayer) then
        addLog("❌ TP ไม่ได้!", Colors.Red); return false
    end

    local prompt = nil
    for i = 1, 10 do
        prompt = findGiftPrompt(targetPlayer.Character)
        if prompt then break end
        task.wait(0.15)
    end
    if not prompt then
        addLog("❌ ไม่พบ ProximityPrompt!", Colors.Orange); return false
    end

    TSL.Text = "📤 ยิงคำสั่ง Gift..."
    pcall(function() fireproximityprompt(prompt) end)
    addLog("✅ ส่ง " .. cardName .. " → " .. targetPlayer.DisplayName, Colors.Green)
    TSL.Text = "✅ ส่งเรียบร้อย!"

    task.wait(0.3)
    return true
end

