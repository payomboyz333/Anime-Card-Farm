local ConfigList = GetConfigs()
local SelectedConfig = ConfigData.Autoload

ConfigDropdown = MiscTab:Dropdown({
    Title = "Saved Configs",
    Values = ConfigList,
    Value = ConfigData.Autoload,
    Callback = function(value)
        if type(value) == "table" then
            for k, v in pairs(value) do
                if type(k) == "number" then
                    SelectedConfig = tostring(v)
                else
                    SelectedConfig = tostring(k)
                end
            end
        elseif type(value) == "string" then
            SelectedConfig = value
        end
    end
})

MiscTab:Button({
    Title = "Load Config",
    Callback = function()
        if SelectedConfig and SelectedConfig ~= "" then
            LoadConfig(SelectedConfig)
        else
            WindUI:Notify({ Title = "Config", Content = "Please select a config to load", Duration = 3 })
        end
    end
})

MiscTab:Toggle({
    Title = "Autoload Config",
    Value = ConfigData.Autoload ~= "",
    Callback = function(state)
        if state then
            if SelectedConfig and SelectedConfig ~= "" then
                ConfigData.Autoload = SelectedConfig
                SaveMainConfig()
                WindUI:Notify({ Title = "Config", Content = "Set autoload to: " .. SelectedConfig, Duration = 3 })
            else
                WindUI:Notify({ Title = "Config", Content = "Please select a config first", Duration = 3 })
            end
        else
            ConfigData.Autoload = ""
            SaveMainConfig()
            WindUI:Notify({ Title = "Config", Content = "Disabled Autoload", Duration = 3 })
        end
    end
})

-- Auto-load configuration on script execution
if ConfigData.Autoload and ConfigData.Autoload ~= "" then
    task.spawn(function()
        task.wait(1)
        LoadConfig(ConfigData.Autoload)
    end)
end
